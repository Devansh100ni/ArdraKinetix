@model TenantDto
@{
    ViewData["Title"] = $"Edit Tenant - {Model.Name}";
}

<div class="max-w-xl mx-auto space-y-6">
    <div class="flex items-center justify-between">
        <div>
            <h2 class="text-2xl font-black text-slate-900 tracking-tight">Edit Tenant</h2>
            <p class="text-xs text-slate-500 mt-0.5 font-medium">Update organization metadata and activation status.</p>
        </div>
        <a href="/Admin/Tenants" class="text-xs font-bold text-indigo-600 hover:text-indigo-700">&larr; Back to Tenants</a>
    </div>

    <div class="bg-white p-8 rounded-3xl border border-slate-200 shadow-sm">
        <form asp-action="TenantsEdit" method="post" class="space-y-5">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="Code" />
            <input type="hidden" asp-for="Prefix" />

            <div asp-validation-summary="ModelOnly" class="p-4 rounded-xl bg-rose-50 border border-rose-200 text-rose-800 text-xs font-semibold"></div>

            <div>
                <label class="block text-xs font-bold uppercase tracking-wider text-slate-500 mb-1.5">Tenant Code & Prefix (Immutable)</label>
                <div class="flex items-center gap-2">
                    <span class="px-3 py-2 rounded-xl bg-slate-100 border border-slate-200 font-mono text-xs font-bold text-indigo-600">@Model.Code</span>
                    <span class="px-3 py-2 rounded-xl bg-slate-100 border border-slate-200 font-mono text-xs font-bold text-slate-700">@Model.Prefix</span>
                </div>
            </div>

            <div>
                <label asp-for="Name" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-2">Organization Name *</label>
                <input asp-for="Name" required class="w-full py-2.5 px-4 bg-white border border-slate-300 rounded-xl text-xs font-semibold text-slate-900 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 focus:outline-none shadow-2xs" />
                <span asp-validation-for="Name" class="text-xs text-rose-600 mt-1 block"></span>
            </div>

            <div class="flex items-center gap-2 pt-2">
                <input asp-for="IsActive" type="checkbox" class="w-4 h-4 rounded border-slate-300 text-indigo-600 focus:ring-indigo-500" />
                <label asp-for="IsActive" class="text-xs text-slate-700 font-medium">Tenant is active and accessible</label>
            </div>

            <div class="flex items-center justify-end gap-3 pt-6 border-t border-slate-100">
                <a href="/Admin/Tenants" class="px-5 py-2.5 rounded-xl bg-white hover:bg-slate-50 text-slate-700 text-xs font-bold border border-slate-200 shadow-2xs transition">Cancel</a>
                <button type="submit" class="px-6 py-2.5 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-bold shadow-md shadow-indigo-500/20 transition">Save Changes</button>
            </div>
        </form>
    </div>
</div>
