@model ChangePasswordViewModel
@{
    Layout = null;
    ViewData["Title"] = "Change Password - ArdraKinetix";
}
<!DOCTYPE html>
<html lang="en" class="h-full bg-slate-50">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    
    <partial name="_Favicons" />
    
    <script src="~/lib/tailwindcss/tailwind.min.js" asp-append-version="true"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        brand: {
                            50: '#f0f9ff',
                            100: '#e0f2fe',
                            200: '#bae6fd',
                            300: '#7dd3fc',
                            400: '#38bdf8',
                            500: '#0ea5e9',
                            600: '#0284c7',
                            700: '#0369a1',
                            800: '#075985',
                            900: '#0c4a6e',
                            950: '#082f49',
                        }
                    }
                }
            }
        }
    </script>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="min-h-screen bg-slate-50 flex flex-col justify-center py-12 sm:px-6 lg:px-8 font-sans antialiased text-slate-900 selection:bg-sky-500 selection:text-white">

    <div class="sm:mx-auto sm:w-full sm:max-w-md text-center">
        <a href="/" class="inline-block mb-4">
            <img src="~/images/ArdraKinetiX.png" alt="ArdraKinetix" class="h-14 w-auto mx-auto object-contain drop-shadow-xs" asp-append-version="true" />
        </a>
        <h2 class="text-2xl font-black tracking-tight text-slate-900">Security Requirement</h2>
        <p class="mt-1 text-xs text-slate-500 font-medium">Please set a new secure password to proceed to your workspace.</p>
    </div>

    <div class="mt-8 sm:mx-auto sm:w-full sm:max-w-md px-4 sm:px-0">
        <div class="bg-white py-8 px-6 shadow-xl shadow-slate-200/50 sm:rounded-3xl sm:px-10 border border-slate-200">
            
            @if (TempData["InfoMessage"] != null)
            {
                <div class="mb-5 p-3.5 rounded-2xl bg-sky-50 border border-sky-200 text-sky-800 text-xs font-medium flex items-center gap-2.5">
                    <svg class="w-4 h-4 shrink-0 text-sky-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                    <span>@TempData["InfoMessage"]</span>
                </div>
            }

            <form asp-action="ChangePassword" method="post" class="space-y-4" id="change-password-form">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly" class="p-3 rounded-xl bg-rose-50 border border-rose-200 text-rose-700 text-xs font-semibold"></div>

                <div>
                    <label asp-for="CurrentPassword" class="block text-xs font-bold text-slate-700 mb-1">Current Password</label>
                    <input asp-for="CurrentPassword" type="password" required class="w-full px-3.5 py-2.5 bg-white border border-slate-300 rounded-xl text-xs font-medium text-slate-900 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-sky-500 focus:border-sky-500 shadow-2xs" />
                    <span asp-validation-for="CurrentPassword" class="text-rose-600 text-[11px] font-semibold mt-1 block"></span>
                </div>

                <div>
                    <label asp-for="NewPassword" class="block text-xs font-bold text-slate-700 mb-1">New Password</label>
                    <input asp-for="NewPassword" type="password" required class="w-full px-3.5 py-2.5 bg-white border border-slate-300 rounded-xl text-xs font-medium text-slate-900 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-sky-500 focus:border-sky-500 shadow-2xs" />
                    <span asp-validation-for="NewPassword" class="text-rose-600 text-[11px] font-semibold mt-1 block"></span>
                </div>

                <div>
                    <label asp-for="ConfirmPassword" class="block text-xs font-bold text-slate-700 mb-1">Confirm New Password</label>
                    <input asp-for="ConfirmPassword" type="password" required class="w-full px-3.5 py-2.5 bg-white border border-slate-300 rounded-xl text-xs font-medium text-slate-900 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-sky-500 focus:border-sky-500 shadow-2xs" />
                    <span asp-validation-for="ConfirmPassword" class="text-rose-600 text-[11px] font-semibold mt-1 block"></span>
                </div>

                <div class="pt-2">
                    <button type="submit" class="w-full flex justify-center py-2.5 px-4 border border-transparent rounded-xl shadow-md shadow-sky-500/20 text-xs font-bold text-white bg-gradient-to-r from-sky-600 via-blue-600 to-cyan-600 hover:from-sky-700 hover:to-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-sky-500 transition transform active:scale-98">
                        Update Password & Continue
                    </button>
                </div>
            </form>

        </div>
    </div>

</body>
</html>
