            </div>
            
            <div class="flex items-center gap-5 font-semibold text-xs">
                <span class="text-sky-600 font-bold">Powered by CodeArdra Solutions</span>
                <span class="text-slate-300">&bull;</span>
                <a href="/Products" class="hover:text-sky-600 transition">Products</a>
                <span class="text-slate-300">&bull;</span>
                <a href="/About" class="hover:text-sky-600 transition">About Us</a>
