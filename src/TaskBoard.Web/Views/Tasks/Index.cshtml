@model TaskListViewModel
@inject TaskBoard.Application.Security.ITenantContext TenantCtx
@inject TaskBoard.Application.Security.ICurrentUserService CurrentUser
@{
    ViewData["Title"] = "Tasks";
}

<div class="space-y-6 max-w-7xl mx-auto">
    <!-- Header -->
    <div class="flex items-center justify-between flex-wrap gap-4">
        <div>
            <h2 class="text-2xl font-black text-slate-900 tracking-tight">Task Management</h2>
            <p class="text-xs text-slate-500 mt-0.5 font-medium">Filter, search, and manage tasks across your tenant scope.</p>
        </div>

        <div class="flex items-center gap-3">
            <a href="/Scrum" class="px-4 py-2 rounded-xl bg-white hover:bg-slate-50 text-slate-700 text-xs font-bold border border-slate-200 shadow-2xs transition">
                Scrum Board View &rarr;
            </a>
            <a href="/Tasks/Create" class="px-4 py-2 rounded-xl bg-sky-600 hover:bg-sky-700 text-white text-xs font-bold shadow-md shadow-sky-500/20 transition">
                + Create Task
            </a>
        </div>
    </div>

    <!-- Filter Bar Card -->
    <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm">
        <form method="get" asp-action="Index" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-4">
            <!-- Search -->
            <div class="lg:col-span-2">
                <label class="block text-[11px] font-bold uppercase tracking-wider text-slate-500 mb-1.5">Search</label>
                <div class="relative">
                    <span class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-slate-400">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
                    </span>
                    <input type="text" name="Search" value="@Model.Criteria.Search" placeholder="Task number, title, description..." class="w-full pl-9 pr-3 py-2 bg-white border border-slate-300 rounded-xl text-xs font-medium text-slate-800 placeholder-slate-400 focus:ring-2 focus:ring-sky-500 focus:border-sky-500 focus:outline-none shadow-2xs" />
                </div>
            </div>

            <!-- Tenant Filter (Admin / Dev) -->
            @if (Model.AvailableTenants.Count > 0)
            {
                var currentT = Model.AvailableTenants.FirstOrDefault(t => t.Id == Model.Criteria.TenantId);
                var currentTLabel = currentT != null ? $"{currentT.Name} ({currentT.Code})" : "All Authorized Tenants";

                <div class="relative" x-data="{ open: false, selectedVal: '@(Model.Criteria.TenantId?.ToString() ?? "")', selectedLabel: '@currentTLabel' }">
                    <label class="block text-[11px] font-bold uppercase tracking-wider text-slate-500 mb-1.5">Tenant</label>
                    <input type="hidden" name="TenantId" :value="selectedVal" />
                    
                    <button type="button" 
                            @@click="open = !open" 
                            @@click.outside="open = false" 
                            class="w-full flex items-center justify-between gap-2 py-2 px-3 bg-white border border-slate-300 hover:border-sky-300 rounded-xl text-xs font-medium text-slate-800 focus:ring-2 focus:ring-sky-500 focus:outline-none shadow-2xs transition text-left">
                        <span x-text="selectedLabel" class="truncate"></span>
                        <svg class="w-4 h-4 text-slate-400 shrink-0 transition-transform duration-200" :class="open ? 'rotate-180 text-sky-600' : ''" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                    </button>

                    <div x-show="open" 
                         x-cloak
                         x-transition:enter="transition ease-out duration-100"
                         x-transition:enter-start="transform opacity-0 scale-95"
                         x-transition:enter-end="transform opacity-100 scale-100"
                         x-transition:leave="transition ease-in duration-75"
                         x-transition:leave-start="transform opacity-100 scale-100"
                         x-transition:leave-end="transform opacity-0 scale-95"
                         class="absolute left-0 mt-1.5 w-full min-w-[200px] rounded-2xl bg-white border border-slate-200 shadow-xl py-1.5 z-50 max-h-56 overflow-y-auto">
                        <button type="button" 
                                @@click="selectedVal = ''; selectedLabel = 'All Authorized Tenants'; open = false" 
                                class="w-full flex items-center justify-between px-3.5 py-2 text-xs font-medium hover:bg-sky-50 hover:text-sky-700 transition"
                                :class="selectedVal === '' ? 'bg-sky-50/80 text-sky-700 font-bold' : 'text-slate-700'">
                            <span>All Authorized Tenants</span>
                            <span x-show="selectedVal === ''" class="text-sky-600 font-bold">&check;</span>
                        </button>
                        @foreach (var t in Model.AvailableTenants)
                        {
                            <button type="button" 
                                    @@click="selectedVal = '@t.Id'; selectedLabel = '@t.Name (@t.Code)'; open = false" 
                                    class="w-full flex items-center justify-between px-3.5 py-2 text-xs font-medium hover:bg-sky-50 hover:text-sky-700 transition"
                                    :class="selectedVal === '@t.Id' ? 'bg-sky-50/80 text-sky-700 font-bold' : 'text-slate-700'">
                                <span class="truncate">@t.Name (@t.Code)</span>
                                <span x-show="selectedVal === '@t.Id'" class="text-sky-600 font-bold">&check;</span>
                            </button>
                        }
                    </div>
                </div>
            }

            <!-- Status Filter -->
            @{
                var currentS = Model.AvailableStatuses.FirstOrDefault(s => s.Id == Model.Criteria.StatusId);
                var currentSLabel = currentS != null ? currentS.Name : "All Statuses";
            }
            <div class="relative" x-data="{ open: false, selectedVal: '@(Model.Criteria.StatusId?.ToString() ?? "")', selectedLabel: '@currentSLabel' }">
                <label class="block text-[11px] font-bold uppercase tracking-wider text-slate-500 mb-1.5">Status</label>
                <input type="hidden" name="StatusId" :value="selectedVal" />
                
                <button type="button" 
                        @@click="open = !open" 
                        @@click.outside="open = false" 
                        class="w-full flex items-center justify-between gap-2 py-2 px-3 bg-white border border-slate-300 hover:border-sky-300 rounded-xl text-xs font-medium text-slate-800 focus:ring-2 focus:ring-sky-500 focus:outline-none shadow-2xs transition text-left">
                    <span x-text="selectedLabel" class="truncate"></span>
                    <svg class="w-4 h-4 text-slate-400 shrink-0 transition-transform duration-200" :class="open ? 'rotate-180 text-sky-600' : ''" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                </button>

                <div x-show="open" 
                     x-cloak
                     x-transition:enter="transition ease-out duration-100"
                     x-transition:enter-start="transform opacity-0 scale-95"
                     x-transition:enter-end="transform opacity-100 scale-100"
                     x-transition:leave="transition ease-in duration-75"
                     x-transition:leave-start="transform opacity-100 scale-100"
                     x-transition:leave-end="transform opacity-0 scale-95"
                     class="absolute left-0 mt-1.5 w-full min-w-[180px] rounded-2xl bg-white border border-slate-200 shadow-xl py-1.5 z-50 max-h-56 overflow-y-auto">
                    <button type="button" 
                            @@click="selectedVal = ''; selectedLabel = 'All Statuses'; open = false" 
                            class="w-full flex items-center justify-between px-3.5 py-2 text-xs font-medium hover:bg-sky-50 hover:text-sky-700 transition"
                            :class="selectedVal === '' ? 'bg-sky-50/80 text-sky-700 font-bold' : 'text-slate-700'">
                        <span>All Statuses</span>
                        <span x-show="selectedVal === ''" class="text-sky-600 font-bold">&check;</span>
                    </button>
                    @foreach (var s in Model.AvailableStatuses)
                    {
                        <button type="button" 
                                @@click="selectedVal = '@s.Id'; selectedLabel = '@s.Name'; open = false" 
                                class="w-full flex items-center justify-between px-3.5 py-2 text-xs font-medium hover:bg-sky-50 hover:text-sky-700 transition"
                                :class="selectedVal === '@s.Id' ? 'bg-sky-50/80 text-sky-700 font-bold' : 'text-slate-700'">
                            <div class="flex items-center gap-2 truncate">
                                <span class="w-2 h-2 rounded-full" style="background-color: @s.Color;"></span>
                                <span class="truncate">@s.Name</span>
                            </div>
                            <span x-show="selectedVal === '@s.Id'" class="text-sky-600 font-bold">&check;</span>
                        </button>
                    }
                </div>
            </div>

            <!-- Priority Filter -->
            @{
                var currentP = Model.AvailablePriorities.FirstOrDefault(p => p.Id == Model.Criteria.PriorityId);
                var currentPLabel = currentP != null ? currentP.Name : "All Priorities";
            }
            <div class="relative" x-data="{ open: false, selectedVal: '@(Model.Criteria.PriorityId?.ToString() ?? "")', selectedLabel: '@currentPLabel' }">
                <label class="block text-[11px] font-bold uppercase tracking-wider text-slate-500 mb-1.5">Priority</label>
                <input type="hidden" name="PriorityId" :value="selectedVal" />
                
                <button type="button" 
                        @@click="open = !open" 
                        @@click.outside="open = false" 
                        class="w-full flex items-center justify-between gap-2 py-2 px-3 bg-white border border-slate-300 hover:border-sky-300 rounded-xl text-xs font-medium text-slate-800 focus:ring-2 focus:ring-sky-500 focus:outline-none shadow-2xs transition text-left">
                    <span x-text="selectedLabel" class="truncate"></span>
                    <svg class="w-4 h-4 text-slate-400 shrink-0 transition-transform duration-200" :class="open ? 'rotate-180 text-sky-600' : ''" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                </button>

                <div x-show="open" 
                     x-cloak
                     x-transition:enter="transition ease-out duration-100"
                     x-transition:enter-start="transform opacity-0 scale-95"
                     x-transition:enter-end="transform opacity-100 scale-100"
                     x-transition:leave="transition ease-in duration-75"
                     x-transition:leave-start="transform opacity-100 scale-100"
                     x-transition:leave-end="transform opacity-0 scale-95"
                     class="absolute left-0 mt-1.5 w-full min-w-[180px] rounded-2xl bg-white border border-slate-200 shadow-xl py-1.5 z-50 max-h-56 overflow-y-auto">
                    <button type="button" 
                            @@click="selectedVal = ''; selectedLabel = 'All Priorities'; open = false" 
                            class="w-full flex items-center justify-between px-3.5 py-2 text-xs font-medium hover:bg-sky-50 hover:text-sky-700 transition"
                            :class="selectedVal === '' ? 'bg-sky-50/80 text-sky-700 font-bold' : 'text-slate-700'">
                        <span>All Priorities</span>
                        <span x-show="selectedVal === ''" class="text-sky-600 font-bold">&check;</span>
                    </button>
                    @foreach (var p in Model.AvailablePriorities)
                    {
                        <button type="button" 
                                @@click="selectedVal = '@p.Id'; selectedLabel = '@p.Name'; open = false" 
                                class="w-full flex items-center justify-between px-3.5 py-2 text-xs font-medium hover:bg-sky-50 hover:text-sky-700 transition"
                                :class="selectedVal === '@p.Id' ? 'bg-sky-50/80 text-sky-700 font-bold' : 'text-slate-700'">
                            <div class="flex items-center gap-2 truncate">
                                <span class="w-2 h-2 rounded-full" style="background-color: @p.Color;"></span>
                                <span class="truncate">@p.Name</span>
                            </div>
                            <span x-show="selectedVal === '@p.Id'" class="text-sky-600 font-bold">&check;</span>
                        </button>
                    }
                </div>
            </div>

            <!-- Actions -->
            <div class="flex items-end gap-2 lg:col-span-5 justify-end pt-2 border-t border-slate-100">
                <a href="/Tasks" class="px-4 py-2 rounded-xl bg-white hover:bg-slate-50 text-slate-700 text-xs font-bold border border-slate-200 shadow-2xs transition">
                    Reset
                </a>
                <button type="submit" class="px-5 py-2 rounded-xl bg-sky-600 hover:bg-sky-700 text-white text-xs font-bold shadow-md shadow-sky-500/20 transition">
                    Apply Filters
                </button>
            </div>
        </form>
    </div>

    <!-- Tasks Table -->
    <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
        @if (Model.Tasks.Items.Count == 0)
        {
            <div class="p-8">
                <partial name="_EmptyState" model="@("No tasks match the selected filters.")" />
            </div>
        }
        else
        {
            <div class="overflow-x-auto">
                <table class="w-full text-left text-xs text-slate-700">
                    <thead class="bg-slate-50 text-slate-500 uppercase font-bold text-[10px] tracking-wider border-b border-slate-200">
                        <tr>
                            <th class="py-3.5 px-6">Task #</th>
                            <th class="py-3.5 px-6">Title</th>
                            <th class="py-3.5 px-6">Tenant</th>
                            <th class="py-3.5 px-6">Status</th>
                            <th class="py-3.5 px-6">Priority</th>
                            <th class="py-3.5 px-6">Assignee</th>
                            <th class="py-3.5 px-6">Estimate</th>
                            <th class="py-3.5 px-6">Created On</th>
                            <th class="py-3.5 px-6 text-right">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100">
                        @foreach (var task in Model.Tasks.Items)
                        {
                            <tr class="hover:bg-slate-50/80 transition group">
                                <td class="py-3.5 px-6 font-mono font-bold text-sky-600">
                                    <a href="/Tasks/Details/@task.Id" class="hover:underline">@task.TaskNumber</a>
                                </td>
                                <td class="py-3.5 px-6 font-semibold text-slate-900">
                                    <a href="/Tasks/Details/@task.Id" class="hover:text-sky-600 transition">
                                        @task.Title
                                    </a>
                                    @if (!string.IsNullOrEmpty(task.ParentTaskNumber))
                                    {
                                        <div class="text-[10px] text-slate-500 font-mono mt-0.5">
                                            Parent: @task.ParentTaskNumber
                                        </div>
                                    }
                                </td>
                                <td class="py-3.5 px-6">
                                    <span class="px-2 py-0.5 rounded bg-slate-100 border border-slate-200 text-[11px] font-mono text-slate-700 font-bold">
                                        @task.TenantCode
                                    </span>
                                </td>
                                <td class="py-3.5 px-6">
                                    <span class="px-2.5 py-0.5 rounded-full text-[11px] font-bold border"
                                          style="background-color: @(task.StatusColor)15; color: @task.StatusColor; border-color: @(task.StatusColor)40;">
                                        @task.StatusName
                                    </span>
                                </td>
                                <td class="py-3.5 px-6">
                                    <span class="px-2.5 py-0.5 rounded-full text-[11px] font-bold border"
                                          style="background-color: @(task.PriorityColor)15; color: @task.PriorityColor; border-color: @(task.PriorityColor)40;">
                                        @task.PriorityName
                                    </span>
                                </td>
                                <td class="py-3.5 px-6 font-medium text-slate-700">
                                    @(task.AssignedUserName ?? "Unassigned")
                                </td>
                                <td class="py-3.5 px-6 text-slate-500 font-medium">
                                    @(task.EstimatedHours.HasValue ? $"{task.EstimatedHours.Value} hrs" : "-")
                                </td>
                                <td class="py-3.5 px-6 text-slate-500 font-medium">
                                    @task.CreatedOn.ToString("MMM dd, yyyy")
                                </td>
                                <td class="py-3.5 px-6 text-right">
                                    <div class="flex items-center justify-end gap-2">
                                        <a href="/Tasks/Details/@task.Id" class="p-1.5 rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-600 hover:text-slate-900 transition" title="View Details">
                                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path></svg>
                                        </a>
                                        <a href="/Tasks/Edit/@task.Id" class="p-1.5 rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-600 hover:text-slate-900 transition" title="Edit">
                                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path></svg>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <partial name="_Pagination" model="Model.Tasks" />
        }
    </div>
</div>
