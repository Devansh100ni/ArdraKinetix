@model TaskDetailsViewModel
@inject TaskBoard.Application.Security.ICurrentUserService CurrentUser
@{
    ViewData["Title"] = $"{Model.Task.TaskNumber} - {Model.Task.Title}";
}

<div class="max-w-6xl mx-auto space-y-6">
    <!-- Breadcrumb & Actions Header -->
    <div class="flex items-center justify-between flex-wrap gap-4">
        <div class="flex items-center gap-2 text-xs text-slate-500 font-medium">
            <a href="/Tasks" class="hover:text-indigo-600">Tasks</a>
            <span>/</span>
            <span class="px-2 py-0.5 rounded-lg bg-slate-100 text-slate-700 font-mono text-[11px] font-bold">@Model.Task.TenantCode</span>
            <span>/</span>
            <span class="text-slate-900 font-mono font-bold">@Model.Task.TaskNumber</span>
        </div>

        <div class="flex items-center gap-3">
            @if (Model.CanEdit)
            {
                <a href="/Tasks/Edit/@Model.Task.Id" class="px-4 py-2 rounded-xl bg-white hover:bg-slate-50 text-slate-700 text-xs font-bold border border-slate-200 shadow-2xs transition flex items-center gap-2">
                    <svg class="w-4 h-4 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path></svg>
                    Edit Task
                </a>
            }

            @if (Model.CanDelete)
            {
                <form asp-action="Delete" asp-route-id="@Model.Task.Id" method="post" onsubmit="return confirm('Are you sure you want to delete this task?');">
                    <button type="submit" class="px-3.5 py-2 rounded-xl bg-rose-50 hover:bg-rose-100 text-rose-700 text-xs font-bold border border-rose-200 transition">
                        Delete
                    </button>
                </form>
            }
        </div>
    </div>

    <!-- Main Title Card -->
    <div class="bg-white p-6 rounded-3xl border border-slate-200 shadow-sm">
        <div class="flex items-start justify-between flex-wrap gap-4 mb-4">
            <div>
                <div class="flex items-center gap-3 mb-2">
                    <span class="font-mono text-sm font-bold text-indigo-600">@Model.Task.TaskNumber</span>
                    <span class="px-3 py-1 rounded-full text-xs font-bold border"
                          style="background-color: @(Model.Task.StatusColor)15; color: @Model.Task.StatusColor; border-color: @(Model.Task.StatusColor)40;">
                        @Model.Task.StatusName
                    </span>
                    <span class="px-3 py-1 rounded-full text-xs font-bold border"
                          style="background-color: @(Model.Task.PriorityColor)15; color: @Model.Task.PriorityColor; border-color: @(Model.Task.PriorityColor)40;">
                        @Model.Task.PriorityName Priority
                    </span>
                </div>
                <h1 class="text-2xl font-black text-slate-900 leading-snug">@Model.Task.Title</h1>
            </div>

            <div class="text-right text-xs text-slate-500 font-medium">
                <div>Tenant: <span class="font-bold text-slate-800">@Model.Task.TenantName</span></div>
                <div class="mt-1">Created on: <span class="text-slate-700">@Model.Task.CreatedOn.ToString("MMM dd, yyyy")</span></div>
            </div>
        </div>

        <!-- Tab Navigation -->
        <div class="flex items-center gap-2 border-b border-slate-100 pt-4 overflow-x-auto">
            <button onclick="window.TaskBoard.switchTab('overview')" data-tab-button="overview" class="px-4 py-2.5 rounded-t-xl text-xs font-bold border-b-2 transition @(Model.ActiveTab == "overview" ? "text-indigo-600 border-indigo-600 bg-indigo-50/80" : "text-slate-500 border-transparent hover:text-slate-900")">
                Overview
            </button>
            <button onclick="window.TaskBoard.switchTab('comments')" data-tab-button="comments" class="px-4 py-2.5 rounded-t-xl text-xs font-bold border-b-2 transition @(Model.ActiveTab == "comments" ? "text-indigo-600 border-indigo-600 bg-indigo-50/80" : "text-slate-500 border-transparent hover:text-slate-900")">
                Comments (@Model.Task.Comments.Count)
            </button>
            <button onclick="window.TaskBoard.switchTab('subtasks')" data-tab-button="subtasks" class="px-4 py-2.5 rounded-t-xl text-xs font-bold border-b-2 transition @(Model.ActiveTab == "subtasks" ? "text-indigo-600 border-indigo-600 bg-indigo-50/80" : "text-slate-500 border-transparent hover:text-slate-900")">
                Subtasks (@Model.Task.ChildTasks.Count)
            </button>
            <button onclick="window.TaskBoard.switchTab('attachments')" data-tab-button="attachments" class="px-4 py-2.5 rounded-t-xl text-xs font-bold border-b-2 transition @(Model.ActiveTab == "attachments" ? "text-indigo-600 border-indigo-600 bg-indigo-50/80" : "text-slate-500 border-transparent hover:text-slate-900")">
                Attachments (@Model.Task.Attachments.Count)
            </button>
            <button onclick="window.TaskBoard.switchTab('audit')" data-tab-button="audit" class="px-4 py-2.5 rounded-t-xl text-xs font-bold border-b-2 transition @(Model.ActiveTab == "audit" ? "text-indigo-600 border-indigo-600 bg-indigo-50/80" : "text-slate-500 border-transparent hover:text-slate-900")">
                History & Audits (@Model.Task.Audits.Count)
            </button>
        </div>
    </div>

    <!-- ========================================== -->
    <!-- TAB 1: OVERVIEW -->
    <!-- ========================================== -->
    <div data-tab-content="overview" class="space-y-6 @(Model.ActiveTab == "overview" ? "" : "hidden")">
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
            <!-- Left 2 Cols: Description & Hierarchy -->
            <div class="lg:col-span-2 space-y-6">
                <!-- Description -->
                <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm">
                    <h3 class="text-xs font-bold uppercase tracking-wider text-slate-500 mb-3">Description</h3>
                    <div class="text-xs text-slate-800 leading-relaxed whitespace-pre-line bg-slate-50 p-4 rounded-xl border border-slate-200/80">
                        @(string.IsNullOrWhiteSpace(Model.Task.Description) ? "No detailed description provided." : Model.Task.Description)
                    </div>
                </div>

                <!-- Parent Task Hierarchy -->
                @if (Model.Task.ParentTask != null)
                {
                    <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm">
                        <h3 class="text-xs font-bold uppercase tracking-wider text-slate-500 mb-3">Parent Task</h3>
                        <a href="/Tasks/Details/@Model.Task.ParentTask.Id" class="flex items-center justify-between p-4 rounded-xl bg-slate-50 border border-slate-200 hover:border-indigo-400 transition group">
                            <div>
                                <span class="font-mono text-xs font-bold text-indigo-600 mr-2">@Model.Task.ParentTask.TaskNumber</span>
                                <span class="text-sm font-semibold text-slate-800 group-hover:text-indigo-600">@Model.Task.ParentTask.Title</span>
                            </div>
                            <span class="text-xs text-indigo-600 font-bold">&rarr;</span>
                        </a>
                    </div>
                }
            </div>

            <!-- Right 1 Col: Metadata & People -->
            <div class="space-y-6">
                <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm space-y-4 text-xs">
                    <h3 class="text-xs font-bold uppercase tracking-wider text-slate-500 mb-2">Assignment & Dates</h3>

                    <!-- Assignee -->
                    <div>
                        <span class="text-slate-500 block mb-1">Assignee</span>
                        @if (Model.Task.AssignedUser != null)
                        {
                            <div class="flex items-center gap-2.5 p-2 rounded-xl bg-slate-50 border border-slate-200">
                                <div class="w-7 h-7 rounded-lg bg-indigo-600 text-white font-bold flex items-center justify-center text-xs uppercase">
                                    @Model.Task.AssignedUser.FullName.Substring(0, 1)
                                </div>
                                <div>
                                    <div class="font-bold text-slate-900">@Model.Task.AssignedUser.FullName</div>
                                    <div class="text-[10px] text-slate-500">@Model.Task.AssignedUser.Email</div>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="p-2 rounded-xl bg-slate-50 border border-slate-200 text-slate-400 italic font-medium">
                                Unassigned
                            </div>
                        }
                    </div>

                    <!-- Creator -->
                    <div>
                        <span class="text-slate-500 block mb-1">Reported By</span>
                        <div class="text-slate-800 font-semibold">@(Model.Task.Creator?.FullName ?? "System")</div>
                    </div>

                    <!-- Estimate -->
                    <div>
                        <span class="text-slate-500 block mb-1">Estimated Hours</span>
                        <div class="text-slate-900 font-bold text-sm">@(Model.Task.EstimatedHours.HasValue ? $"{Model.Task.EstimatedHours.Value} hours" : "Not specified")</div>
                    </div>

                    <!-- Started / End Dates -->
                    <div class="grid grid-cols-2 gap-2 pt-2 border-t border-slate-100">
                        <div>
                            <span class="text-slate-500 block mb-1">Started On</span>
                            <div class="text-slate-800 font-semibold">@(Model.Task.StartedOn?.ToString("MMM dd, yyyy") ?? "-")</div>
                        </div>
                        <div>
                            <span class="text-slate-500 block mb-1">Target End Date</span>
                            <div class="text-slate-800 font-semibold">@(Model.Task.EndOn?.ToString("MMM dd, yyyy") ?? "-")</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ========================================== -->
    <!-- TAB 2: COMMENTS -->
    <!-- ========================================== -->
    <div data-tab-content="comments" class="space-y-6 @(Model.ActiveTab == "comments" ? "" : "hidden")">
        <!-- New Comment Form -->
        <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm">
            <h3 class="text-sm font-bold text-slate-900 mb-3">Add a Comment / Note</h3>
            <form id="addCommentForm" onsubmit="submitComment(event)">
                @Html.AntiForgeryToken()
                <input type="hidden" name="TaskId" value="@Model.Task.Id" />
                <textarea id="commentInput" name="Comment" rows="3" required placeholder="Write your task updates, blocker notes, or progress comments..." class="w-full p-3 bg-white border border-slate-300 rounded-xl text-xs font-medium text-slate-900 placeholder-slate-400 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 focus:outline-none shadow-2xs"></textarea>
                <div class="flex justify-end mt-3">
                    <button type="submit" class="px-4 py-2 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-bold shadow-md shadow-indigo-500/20 transition">
                        Post Comment
                    </button>
                </div>
            </form>
        </div>

        <!-- Comments Stream -->
        <div id="commentsList" class="space-y-4">
            @if (Model.Task.Comments.Count == 0)
            {
                <partial name="_EmptyState" model="@("No comments yet. Be the first to start the discussion.")" />
            }
            else
            {
                @foreach (var comment in Model.Task.Comments)
                {
                    <div id="comment-@comment.Id" class="bg-white p-4 rounded-2xl border border-slate-200 shadow-2xs flex items-start gap-4">
                        <div class="w-8 h-8 rounded-lg bg-indigo-600 text-white font-bold flex items-center justify-center text-xs shrink-0 uppercase">
                            @comment.UserFullName.Substring(0, 1)
                        </div>
                        <div class="flex-1 min-w-0">
                            <div class="flex items-center justify-between mb-1">
                                <span class="text-xs font-bold text-slate-900">@comment.UserFullName</span>
                                <span class="text-[10px] text-slate-500 font-medium">@comment.CreatedOn.ToString("MMM dd, yyyy HH:mm")</span>
                            </div>
                            <p class="text-xs text-slate-700 whitespace-pre-line leading-relaxed font-medium">@comment.Comment</p>
                        </div>
                        @if (comment.CanDelete)
                        {
                            <button type="button" onclick="deleteComment('@comment.Id')" class="text-slate-400 hover:text-rose-600 p-1 transition" title="Delete Comment">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
                            </button>
                        }
                    </div>
                }
            }
        </div>
    </div>

    <!-- ========================================== -->
    <!-- TAB 3: SUBTASKS / CHILD TASKS -->
    <!-- ========================================== -->
    <div data-tab-content="subtasks" class="space-y-6 @(Model.ActiveTab == "subtasks" ? "" : "hidden")">
        <div class="flex items-center justify-between">
            <h3 class="text-sm font-bold text-slate-900">Child Subtasks Hierarchy</h3>
            <a href="/Tasks/Create?parentTaskId=@Model.Task.Id&tenantId=@Model.Task.TenantId" class="px-3.5 py-2 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-bold shadow-md shadow-indigo-500/20 transition">
                + Create Subtask
            </a>
        </div>

        @if (Model.Task.ChildTasks.Count == 0)
        {
            <partial name="_EmptyState" model="@("No child subtasks created for this task yet.")" />
        }
        else
        {
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                @foreach (var child in Model.Task.ChildTasks)
                {
                    <partial name="_TaskCard" model="child" />
                }
            </div>
        }
    </div>

    <!-- ========================================== -->
    <!-- TAB 4: ATTACHMENTS -->
    <!-- ========================================== -->
    <div data-tab-content="attachments" class="space-y-6 @(Model.ActiveTab == "attachments" ? "" : "hidden")">
        <!-- Upload Form Card -->
        <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm">
            <h3 class="text-sm font-bold text-slate-900 mb-1">Upload Attachments (Images or PDFs)</h3>
            <p class="text-xs text-slate-500 mb-4 font-medium">Supported formats: PNG, JPG, JPEG, WebP, PDF (Max 10MB). File contents and extensions are validated server-side.</p>

            <form id="uploadAttachmentForm" onsubmit="submitAttachment(event)" class="flex items-center gap-3">
                @Html.AntiForgeryToken()
                <input type="hidden" name="taskId" value="@Model.Task.Id" />
                <input type="file" id="attachmentFileInput" name="file" accept=".png,.jpg,.jpeg,.webp,.pdf" required class="text-xs text-slate-600 file:mr-4 file:py-2 file:px-4 file:rounded-xl file:border-0 file:text-xs file:font-bold file:bg-slate-100 file:text-slate-700 hover:file:bg-slate-200 cursor-pointer" />
                <button type="submit" class="px-4 py-2 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-bold shadow-md shadow-indigo-500/20 transition">
                    Upload Attachment
                </button>
            </form>
        </div>

        <!-- Attachments Grid -->
        <div id="attachmentsGrid" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
            @if (Model.Task.Attachments.Count == 0)
            {
                <div class="col-span-full">
                    <partial name="_EmptyState" model="@("No attachments uploaded yet.")" />
                </div>
            }
            else
            {
                @foreach (var att in Model.Task.Attachments)
                {
                    <div id="attachment-@att.Id" class="bg-white p-4 rounded-2xl border border-slate-200 shadow-2xs flex flex-col justify-between space-y-3">
                        <div class="flex items-start gap-3">
                            <div class="w-10 h-10 rounded-xl bg-indigo-50 border border-indigo-100 flex items-center justify-center shrink-0 text-indigo-600">
                                @if (att.IsImage)
                                {
                                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                                }
                                else
                                {
                                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
                                }
                            </div>
                            <div class="min-w-0 flex-1">
                                <div class="text-xs font-bold text-slate-900 truncate" title="@att.FileName">@att.FileName</div>
                                <div class="text-[10px] text-slate-500 font-medium">@att.FormattedSize &bull; @att.UploadedOn.ToString("MMM dd, yyyy")</div>
                            </div>
                        </div>

                        @if (att.IsImage)
                        {
                            <div class="h-32 bg-slate-50 rounded-xl overflow-hidden border border-slate-200 flex items-center justify-center cursor-pointer" onclick="openPreviewModal('@att.PreviewUrl', '@att.FileName', true)">
                                <img src="@att.PreviewUrl" alt="@att.FileName" class="w-full h-full object-cover hover:scale-105 transition" />
                            </div>
                        }

                        <div class="flex items-center justify-between pt-2 border-t border-slate-100 text-xs">
                            <a href="@att.DownloadUrl" class="text-indigo-600 hover:text-indigo-700 font-bold flex items-center gap-1">
                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path></svg>
                                Download
                            </a>

                            <button type="button" onclick="deleteAttachment('@att.Id')" class="text-slate-400 hover:text-rose-600 p-1 transition" title="Delete Attachment">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
                            </button>
                        </div>
                    </div>
                }
            }
        </div>
    </div>

    <!-- ========================================== -->
    <!-- TAB 5: AUDIT HISTORY -->
    <!-- ========================================== -->
    <div data-tab-content="audit" class="space-y-6 @(Model.ActiveTab == "audit" ? "" : "hidden")">
        <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
            @if (Model.Task.Audits.Count == 0)
            {
                <div class="p-8">
                    <partial name="_EmptyState" model="@("No audit history entries recorded for this task.")" />
                </div>
            }
            else
            {
                <div class="overflow-x-auto">
                    <table class="w-full text-left text-xs text-slate-700">
                        <thead class="bg-slate-50 text-slate-500 uppercase font-bold text-[10px] tracking-wider border-b border-slate-200">
                            <tr>
                                <th class="py-3.5 px-6">Timestamp (UTC)</th>
                                <th class="py-3.5 px-6">User</th>
                                <th class="py-3.5 px-6">Action</th>
                                <th class="py-3.5 px-6">Field</th>
                                <th class="py-3.5 px-6">Old Value</th>
                                <th class="py-3.5 px-6">New Value</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100 font-mono">
                            @foreach (var a in Model.Task.Audits)
                            {
                                <tr class="hover:bg-slate-50/80 transition">
                                    <td class="py-3.5 px-6 text-slate-500 font-medium">@a.CreatedOn.ToString("yyyy-MM-dd HH:mm:ss")</td>
                                    <td class="py-3.5 px-6 font-sans font-semibold text-slate-900">@a.UserFullName</td>
                                    <td class="py-3.5 px-6">
                                        <span class="px-2 py-0.5 rounded bg-slate-100 border border-slate-200 text-indigo-600 font-bold text-[10px]">
                                            @a.Action
                                        </span>
                                    </td>
                                    <td class="py-3.5 px-6 text-slate-700 font-medium">@(a.FieldName ?? "-")</td>
                                    <td class="py-3.5 px-6 text-rose-600 font-medium max-w-xs truncate" title="@a.OldValue">@(a.OldValue ?? "-")</td>
                                    <td class="py-3.5 px-6 text-emerald-600 font-medium max-w-xs truncate" title="@a.NewValue">@(a.NewValue ?? "-")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

<!-- Image/PDF Preview Modal -->
<div id="previewModal" class="fixed inset-0 z-50 bg-slate-900/40 backdrop-blur-xs hidden items-center justify-center p-6">
    <div class="bg-white max-w-4xl w-full rounded-3xl border border-slate-200 p-6 flex flex-col max-h-[90vh] shadow-2xl">
        <div class="flex items-center justify-between pb-4 border-b border-slate-100">
            <h3 id="previewModalTitle" class="text-sm font-bold text-slate-900 truncate">Attachment Preview</h3>
            <button onclick="window.TaskBoard.closeModal('previewModal')" class="text-slate-400 hover:text-slate-700 p-1 rounded-lg hover:bg-slate-100 transition">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
            </button>
        </div>
        <div class="flex-1 overflow-auto p-4 flex items-center justify-center" id="previewModalContent">
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/task-details.js" asp-append-version="true"></script>
}
