@using TaskBoard.Application.Common
@model IPagedResult

@functions {
    string BuildPageUrl(int pageNumber, int pageSize)
    {
        var query = Context.Request.Query;
        var queryParams = new List<string>();

        foreach (var key in query.Keys)
        {
            if (string.Equals(key, "PageNumber", StringComparison.OrdinalIgnoreCase) ||
                string.Equals(key, "PageSize", StringComparison.OrdinalIgnoreCase))
            {
                continue;
            }

            var val = query[key].ToString();
            if (!string.IsNullOrWhiteSpace(val))
            {
                queryParams.Add($"{Uri.EscapeDataString(key)}={Uri.EscapeDataString(val)}");
            }
        }

        queryParams.Add($"PageNumber={pageNumber}");
        if (pageSize != 10 && pageSize > 0)
        {
            queryParams.Add($"PageSize={pageSize}");
        }

        var path = Context.Request.Path;
        return $"{path}?{string.Join("&", queryParams)}";
    }
}

@if (Model != null && Model.TotalPages > 1)
{
    <div class="flex items-center justify-between px-6 py-3.5 bg-slate-50 border-t border-slate-200 rounded-b-2xl text-xs">
        <div class="text-slate-500">
            Showing <span class="font-bold text-slate-800">@((Model.PageNumber - 1) * Model.PageSize + 1)</span> to 
            <span class="font-bold text-slate-800">@(Math.Min(Model.PageNumber * Model.PageSize, Model.TotalCount))</span> of 
            <span class="font-bold text-slate-800">@Model.TotalCount</span> records
        </div>

        <div class="flex items-center gap-2">
            @if (Model.HasPreviousPage)
            {
                <a href="@BuildPageUrl(Model.PageNumber - 1, Model.PageSize)"
                   class="px-3 py-1.5 rounded-xl border border-slate-200 bg-white hover:bg-slate-100 text-slate-700 font-semibold shadow-2xs transition">
                    &larr; Previous
                </a>
            }
            else
            {
                <span class="px-3 py-1.5 rounded-xl border border-slate-200 bg-slate-100 text-slate-400 font-semibold cursor-not-allowed">
                    &larr; Previous
                </span>
            }

            <span class="px-3 py-1 font-bold text-sky-700 bg-sky-50 rounded-xl border border-sky-200">
                Page @Model.PageNumber of @Model.TotalPages
            </span>

            @if (Model.HasNextPage)
            {
                <a href="@BuildPageUrl(Model.PageNumber + 1, Model.PageSize)"
                   class="px-3 py-1.5 rounded-xl border border-slate-200 bg-white hover:bg-slate-100 text-slate-700 font-semibold shadow-2xs transition">
                    Next &rarr;
                </a>
            }
            else
            {
                <span class="px-3 py-1.5 rounded-xl border border-slate-200 bg-slate-100 text-slate-400 font-semibold cursor-not-allowed">
                    Next &rarr;
                </span>
            }
        </div>
    </div>
}
