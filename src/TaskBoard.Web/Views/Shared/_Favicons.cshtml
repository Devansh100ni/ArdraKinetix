<!-- Favicons & Mobile Web App Meta -->
<link rel="icon" type="image/x-icon" href="~/favicons/favicon.ico" asp-append-version="true" />
<link rel="icon" type="image/png" sizes="16x16" href="~/favicons/favicon-16x16.png" asp-append-version="true" />
<link rel="icon" type="image/png" sizes="32x32" href="~/favicons/favicon-32x32.png" asp-append-version="true" />
<link rel="icon" type="image/png" sizes="48x48" href="~/favicons/favicon-48x48.png" asp-append-version="true" />
<link rel="manifest" href="~/favicons/manifest.webmanifest" crossOrigin="use-credentials" />
<meta name="mobile-web-app-capable" content="yes" />
<meta name="theme-color" content="#fff" />
<meta name="application-name" content="Image to Favicon From Poper" />
<link rel="apple-touch-icon" sizes="180x180" href="~/favicons/apple-touch-icon-180x180.png" asp-append-version="true" />
<meta name="apple-mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
<meta name="apple-mobile-web-app-title" content="Image to Favicon From Poper" />
