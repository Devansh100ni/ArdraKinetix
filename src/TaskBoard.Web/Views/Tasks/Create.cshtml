@model TaskCreateEditViewModel
@inject TaskBoard.Application.Security.ITenantContext TenantCtx
@inject TaskBoard.Application.Security.ICurrentUserService CurrentUser
@{
    ViewData["Title"] = "Create New Task";
}

<div class="max-w-3xl mx-auto space-y-6">
    <div class="flex items-center justify-between">
        <div>
            <h2 class="text-2xl font-black text-slate-900 tracking-tight">Create Task</h2>
            <p class="text-xs text-slate-500 mt-0.5 font-medium">Define a work item with automated tenant task sequencing.</p>
        </div>
        <a href="/Tasks" class="text-xs font-bold text-sky-600 hover:text-sky-700">&larr; Back to Tasks</a>
    </div>

    <div class="bg-white p-8 rounded-3xl border border-slate-200 shadow-sm">
        <form asp-action="Create" method="post" class="space-y-6">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="p-4 rounded-xl bg-rose-50 border border-rose-200 text-rose-800 text-xs font-semibold"></div>

            <!-- Tenant Selection (if Admin or Dev with multiple tenants) -->
            @if (TenantCtx.IsGlobalAdmin || (CurrentUser.IsInRole(SystemRoles.Developer) && Model.AvailableTenants.Count > 1))
            {
                var defaultT = Model.AvailableTenants.FirstOrDefault(t => t.Id == Model.TenantId) ?? Model.AvailableTenants.FirstOrDefault();
                var defaultTVal = defaultT?.Id.ToString() ?? "";
                var defaultTLabel = defaultT != null ? $"{defaultT.Name} ({defaultT.Code})" : "Select Tenant";

                <div class="relative" x-data="{ open: false, selectedVal: '@defaultTVal', selectedLabel: '@defaultTLabel' }">
                    <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-2">Target Tenant *</label>
                    <input type="hidden" name="TenantId" :value="selectedVal" required />
                    
                    <button type="button" 
                            @@click="open = !open" 
                            @@click.outside="open = false" 
                            class="w-full flex items-center justify-between py-2.5 px-3.5 bg-white border border-slate-300 hover:border-sky-300 rounded-xl text-xs font-semibold text-slate-800 focus:ring-2 focus:ring-sky-500 focus:outline-none shadow-2xs transition text-left">
                        <span x-text="selectedLabel" class="truncate"></span>
                        <svg class="w-4 h-4 text-slate-400 shrink-0 transition-transform duration-200" :class="open ? 'rotate-180 text-sky-600' : ''" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                    </button>

                    <div x-show="open" 
                         x-cloak
                         x-transition:enter="transition ease-out duration-100"
                         x-transition:enter-start="transform opacity-0 scale-95"
                         x-transition:enter-end="transform opacity-100 scale-100"
                         x-transition:leave="transition ease-in duration-75"
                         x-transition:leave-start="transform opacity-100 scale-100"
                         x-transition:leave-end="transform opacity-0 scale-95"
                         class="absolute left-0 mt-1.5 w-full rounded-2xl bg-white border border-slate-200 shadow-xl py-1.5 z-50 max-h-56 overflow-y-auto">
                        @foreach (var t in Model.AvailableTenants)
                        {
                            <button type="button" 
                                    @@click="selectedVal = '@t.Id'; selectedLabel = '@t.Name (@t.Code)'; open = false" 
                                    class="w-full flex items-center justify-between px-3.5 py-2.5 text-xs font-medium hover:bg-sky-50 hover:text-sky-700 transition"
                                    :class="selectedVal === '@t.Id' ? 'bg-sky-50/80 text-sky-700 font-bold' : 'text-slate-700'">
                                <span class="truncate">@t.Name (@t.Code)</span>
                                <span x-show="selectedVal === '@t.Id'" class="text-sky-600 font-bold">&check;</span>
                            </button>
                        }
                    </div>
                    <span asp-validation-for="TenantId" class="text-xs text-rose-600 mt-1 block"></span>
                </div>
            }
            else
            {
                <input type="hidden" asp-for="TenantId" />
            }

            <!-- Task Title -->
            <div>
                <label asp-for="Title" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-2">Task Title *</label>
                <input asp-for="Title" required placeholder="e.g. Implement Multi-Tenant Authentication Guard" class="w-full py-2.5 px-4 bg-white border border-slate-300 rounded-xl text-sm font-semibold text-slate-900 placeholder-slate-400 focus:ring-2 focus:ring-sky-500 focus:border-sky-500 focus:outline-none shadow-2xs" />
                <span asp-validation-for="Title" class="text-xs text-rose-600 mt-1 block"></span>
            </div>

            <!-- Description -->
            <div>
                <label asp-for="Description" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-2">Description & Acceptance Criteria</label>
                <textarea asp-for="Description" rows="4" placeholder="Detailed user story, acceptance tests, and technical notes..." class="w-full p-3.5 bg-white border border-slate-300 rounded-xl text-xs font-medium text-slate-900 placeholder-slate-400 focus:ring-2 focus:ring-sky-500 focus:border-sky-500 focus:outline-none shadow-2xs"></textarea>
                <span asp-validation-for="Description" class="text-xs text-rose-600 mt-1 block"></span>
            </div>

            <!-- Status & Priority Grid -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                @{
                    var defaultS = Model.AvailableStatuses.FirstOrDefault(s => s.Id == Model.StatusId) ?? Model.AvailableStatuses.FirstOrDefault();
                    var defaultSVal = defaultS?.Id.ToString() ?? "";
                    var defaultSLabel = defaultS?.Name ?? "Select Status";
                }
                <div class="relative" x-data="{ open: false, selectedVal: '@defaultSVal', selectedLabel: '@defaultSLabel' }">
                    <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-2">Status *</label>
                    <input type="hidden" name="StatusId" :value="selectedVal" required />
                    
                    <button type="button" 
                            @@click="open = !open" 
                            @@click.outside="open = false" 
                            class="w-full flex items-center justify-between py-2.5 px-3.5 bg-white border border-slate-300 hover:border-sky-300 rounded-xl text-xs font-semibold text-slate-800 focus:ring-2 focus:ring-sky-500 focus:outline-none shadow-2xs transition text-left">
                        <span x-text="selectedLabel" class="truncate"></span>
                        <svg class="w-4 h-4 text-slate-400 shrink-0 transition-transform duration-200" :class="open ? 'rotate-180 text-sky-600' : ''" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                    </button>

                    <div x-show="open" 
                         x-cloak
                         x-transition:enter="transition ease-out duration-100"
                         x-transition:enter-start="transform opacity-0 scale-95"
                         x-transition:enter-end="transform opacity-100 scale-100"
                         x-transition:leave="transition ease-in duration-75"
                         x-transition:leave-start="transform opacity-100 scale-100"
                         x-transition:leave-end="transform opacity-0 scale-95"
                         class="absolute left-0 mt-1.5 w-full rounded-2xl bg-white border border-slate-200 shadow-xl py-1.5 z-50 max-h-56 overflow-y-auto">
                        @foreach (var s in Model.AvailableStatuses)
                        {
                            <button type="button" 
                                    @@click="selectedVal = '@s.Id'; selectedLabel = '@s.Name'; open = false" 
                                    class="w-full flex items-center justify-between px-3.5 py-2.5 text-xs font-medium hover:bg-sky-50 hover:text-sky-700 transition"
                                    :class="selectedVal === '@s.Id' ? 'bg-sky-50/80 text-sky-700 font-bold' : 'text-slate-700'">
                                <div class="flex items-center gap-2 truncate">
                                    <span class="w-2.5 h-2.5 rounded-full" style="background-color: @s.Color;"></span>
                                    <span class="truncate">@s.Name</span>
                                </div>
                                <span x-show="selectedVal === '@s.Id'" class="text-sky-600 font-bold">&check;</span>
                            </button>
                        }
                    </div>
                    <span asp-validation-for="StatusId" class="text-xs text-rose-600 mt-1 block"></span>
                </div>

                @{
                    var defaultP = Model.AvailablePriorities.FirstOrDefault(p => p.Id == Model.PriorityId) ?? Model.AvailablePriorities.FirstOrDefault();
                    var defaultPVal = defaultP?.Id.ToString() ?? "";
                    var defaultPLabel = defaultP?.Name ?? "Select Priority";
                }
                <div class="relative" x-data="{ open: false, selectedVal: '@defaultPVal', selectedLabel: '@defaultPLabel' }">
                    <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-2">Priority *</label>
                    <input type="hidden" name="PriorityId" :value="selectedVal" required />
                    
                    <button type="button" 
                            @@click="open = !open" 
                            @@click.outside="open = false" 
                            class="w-full flex items-center justify-between py-2.5 px-3.5 bg-white border border-slate-300 hover:border-sky-300 rounded-xl text-xs font-semibold text-slate-800 focus:ring-2 focus:ring-sky-500 focus:outline-none shadow-2xs transition text-left">
                        <span x-text="selectedLabel" class="truncate"></span>
                        <svg class="w-4 h-4 text-slate-400 shrink-0 transition-transform duration-200" :class="open ? 'rotate-180 text-sky-600' : ''" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                    </button>

                    <div x-show="open" 
                         x-cloak
                         x-transition:enter="transition ease-out duration-100"
                         x-transition:enter-start="transform opacity-0 scale-95"
                         x-transition:enter-end="transform opacity-100 scale-100"
                         x-transition:leave="transition ease-in duration-75"
                         x-transition:leave-start="transform opacity-100 scale-100"
                         x-transition:leave-end="transform opacity-0 scale-95"
                         class="absolute left-0 mt-1.5 w-full rounded-2xl bg-white border border-slate-200 shadow-xl py-1.5 z-50 max-h-56 overflow-y-auto">
                        @foreach (var p in Model.AvailablePriorities)
                        {
                            <button type="button" 
                                    @@click="selectedVal = '@p.Id'; selectedLabel = '@p.Name'; open = false" 
                                    class="w-full flex items-center justify-between px-3.5 py-2.5 text-xs font-medium hover:bg-sky-50 hover:text-sky-700 transition"
                                    :class="selectedVal === '@p.Id' ? 'bg-sky-50/80 text-sky-700 font-bold' : 'text-slate-700'">
                                <div class="flex items-center gap-2 truncate">
                                    <span class="w-2.5 h-2.5 rounded-full" style="background-color: @p.Color;"></span>
                                    <span class="truncate">@p.Name</span>
                                </div>
                                <span x-show="selectedVal === '@p.Id'" class="text-sky-600 font-bold">&check;</span>
                            </button>
                        }
                    </div>
                    <span asp-validation-for="PriorityId" class="text-xs text-rose-600 mt-1 block"></span>
                </div>
            </div>

            <!-- Assignee & Parent Task -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                @{
                    var defaultU = Model.AvailableUsers.FirstOrDefault(u => u.Id == Model.AssignedUserId);
                    var defaultUVal = defaultU?.Id.ToString() ?? "";
                    var defaultULabel = defaultU != null ? $"{defaultU.FullName} ({defaultU.Email})" : "-- Unassigned --";
                }
                <div class="relative" x-data="{ open: false, selectedVal: '@defaultUVal', selectedLabel: '@defaultULabel' }">
                    <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-2">Assignee</label>
                    <input type="hidden" name="AssignedUserId" :value="selectedVal" />
                    
                    <button type="button" 
                            @@click="open = !open" 
                            @@click.outside="open = false" 
                            class="w-full flex items-center justify-between py-2.5 px-3.5 bg-white border border-slate-300 hover:border-sky-300 rounded-xl text-xs font-semibold text-slate-800 focus:ring-2 focus:ring-sky-500 focus:outline-none shadow-2xs transition text-left">
                        <span x-text="selectedLabel" class="truncate"></span>
                        <svg class="w-4 h-4 text-slate-400 shrink-0 transition-transform duration-200" :class="open ? 'rotate-180 text-sky-600' : ''" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                    </button>

                    <div x-show="open" 
                         x-cloak
                         x-transition:enter="transition ease-out duration-100"
                         x-transition:enter-start="transform opacity-0 scale-95"
                         x-transition:enter-end="transform opacity-100 scale-100"
                         x-transition:leave="transition ease-in duration-75"
                         x-transition:leave-start="transform opacity-100 scale-100"
                         x-transition:leave-end="transform opacity-0 scale-95"
                         class="absolute left-0 mt-1.5 w-full rounded-2xl bg-white border border-slate-200 shadow-xl py-1.5 z-50 max-h-56 overflow-y-auto">
                        <button type="button" 
                                @@click="selectedVal = ''; selectedLabel = '-- Unassigned --'; open = false" 
                                class="w-full flex items-center justify-between px-3.5 py-2.5 text-xs font-medium hover:bg-sky-50 hover:text-sky-700 transition"
                                :class="selectedVal === '' ? 'bg-sky-50/80 text-sky-700 font-bold' : 'text-slate-700'">
                            <span>-- Unassigned --</span>
                            <span x-show="selectedVal === ''" class="text-sky-600 font-bold">&check;</span>
                        </button>
                        @foreach (var u in Model.AvailableUsers)
                        {
                            <button type="button" 
                                    @@click="selectedVal = '@u.Id'; selectedLabel = '@u.FullName (@u.Email)'; open = false" 
                                    class="w-full flex items-center justify-between px-3.5 py-2.5 text-xs font-medium hover:bg-sky-50 hover:text-sky-700 transition"
                                    :class="selectedVal === '@u.Id' ? 'bg-sky-50/80 text-sky-700 font-bold' : 'text-slate-700'">
                                <span class="truncate">@u.FullName (@u.Email)</span>
                                <span x-show="selectedVal === '@u.Id'" class="text-sky-600 font-bold">&check;</span>
                            </button>
                        }
                    </div>
                </div>

                @{
                    var defaultPT = Model.AvailableParentTasks.FirstOrDefault(pt => pt.Id == Model.ParentTaskId);
                    var defaultPTVal = defaultPT?.Id.ToString() ?? "";
                    var defaultPTLabel = defaultPT != null ? $"{defaultPT.TaskNumber} - {defaultPT.Title}" : "-- No Parent (Root Task) --";
                }
                <div class="relative" x-data="{ open: false, selectedVal: '@defaultPTVal', selectedLabel: '@defaultPTLabel' }">
                    <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-2">Parent Task (Optional)</label>
                    <input type="hidden" name="ParentTaskId" :value="selectedVal" />
                    
                    <button type="button" 
                            @@click="open = !open" 
                            @@click.outside="open = false" 
                            class="w-full flex items-center justify-between py-2.5 px-3.5 bg-white border border-slate-300 hover:border-sky-300 rounded-xl text-xs font-semibold text-slate-800 focus:ring-2 focus:ring-sky-500 focus:outline-none shadow-2xs transition text-left">
                        <span x-text="selectedLabel" class="truncate"></span>
                        <svg class="w-4 h-4 text-slate-400 shrink-0 transition-transform duration-200" :class="open ? 'rotate-180 text-sky-600' : ''" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                    </button>

                    <div x-show="open" 
                         x-cloak
                         x-transition:enter="transition ease-out duration-100"
                         x-transition:enter-start="transform opacity-0 scale-95"
                         x-transition:enter-end="transform opacity-100 scale-100"
                         x-transition:leave="transition ease-in duration-75"
                         x-transition:leave-start="transform opacity-100 scale-100"
                         x-transition:leave-end="transform opacity-0 scale-95"
                         class="absolute left-0 mt-1.5 w-full rounded-2xl bg-white border border-slate-200 shadow-xl py-1.5 z-50 max-h-56 overflow-y-auto">
                        <button type="button" 
                                @@click="selectedVal = ''; selectedLabel = '-- No Parent (Root Task) --'; open = false" 
                                class="w-full flex items-center justify-between px-3.5 py-2.5 text-xs font-medium hover:bg-sky-50 hover:text-sky-700 transition"
                                :class="selectedVal === '' ? 'bg-sky-50/80 text-sky-700 font-bold' : 'text-slate-700'">
                            <span>-- No Parent (Root Task) --</span>
                            <span x-show="selectedVal === ''" class="text-sky-600 font-bold">&check;</span>
                        </button>
                        @foreach (var pt in Model.AvailableParentTasks)
                        {
                            <button type="button" 
                                    @@click="selectedVal = '@pt.Id'; selectedLabel = '@pt.TaskNumber - @pt.Title'; open = false" 
                                    class="w-full flex items-center justify-between px-3.5 py-2.5 text-xs font-medium hover:bg-sky-50 hover:text-sky-700 transition"
                                    :class="selectedVal === '@pt.Id' ? 'bg-sky-50/80 text-sky-700 font-bold' : 'text-slate-700'">
                                <span class="truncate">@pt.TaskNumber - @pt.Title</span>
                                <span x-show="selectedVal === '@pt.Id'" class="text-sky-600 font-bold">&check;</span>
                            </button>
                        }
                    </div>
                </div>
            </div>

            <!-- Estimate & Dates -->
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                <div>
                    <label asp-for="EstimatedHours" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-2">Estimate (Hours)</label>
                    <input asp-for="EstimatedHours" type="number" step="0.5" min="0" placeholder="e.g. 8.0" class="w-full py-2.5 px-3.5 bg-white border border-slate-300 rounded-xl text-xs font-semibold text-slate-800 focus:ring-2 focus:ring-sky-500 focus:border-sky-500 focus:outline-none shadow-2xs" />
                </div>

                <div>
                    <label asp-for="StartedOn" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-2">Start Date</label>
                    <input asp-for="StartedOn" type="date" class="w-full py-2.5 px-3.5 bg-white border border-slate-300 rounded-xl text-xs font-semibold text-slate-800 focus:ring-2 focus:ring-sky-500 focus:border-sky-500 focus:outline-none shadow-2xs" />
                </div>

                <div>
                    <label asp-for="EndOn" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-2">Target End Date</label>
                    <input asp-for="EndOn" type="date" class="w-full py-2.5 px-3.5 bg-white border border-slate-300 rounded-xl text-xs font-semibold text-slate-800 focus:ring-2 focus:ring-sky-500 focus:border-sky-500 focus:outline-none shadow-2xs" />
                </div>
            </div>

            <div class="flex items-center justify-end gap-3 pt-6 border-t border-slate-100">
                <a href="/Tasks" class="px-5 py-2.5 rounded-xl bg-white hover:bg-slate-50 text-slate-700 text-xs font-bold border border-slate-200 shadow-2xs transition">Cancel</a>
                <button type="submit" class="px-6 py-2.5 rounded-xl bg-sky-600 hover:bg-sky-700 text-white text-xs font-bold shadow-md shadow-sky-500/20 transition">
                    Save and Create Task
                </button>
            </div>
        </form>
    </div>
</div>
