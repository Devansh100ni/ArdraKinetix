@model TaskCreateEditViewModel
@inject TaskBoard.Application.Security.ITenantContext TenantCtx
@inject TaskBoard.Application.Security.ICurrentUserService CurrentUser
@{
    ViewData["Title"] = "Create New Task";
}

<div class="max-w-3xl mx-auto space-y-6">
    <div class="flex items-center justify-between">
        <div>
            <h2 class="text-2xl font-black text-slate-900 tracking-tight">Create Task</h2>
            <p class="text-xs text-slate-500 mt-0.5 font-medium">Define a work item with automated tenant task sequencing.</p>
        </div>
        <a href="/Tasks" class="text-xs font-bold text-indigo-600 hover:text-indigo-700">&larr; Back to Tasks</a>
    </div>

    <div class="bg-white p-8 rounded-3xl border border-slate-200 shadow-sm">
        <form asp-action="Create" method="post" class="space-y-6">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="p-4 rounded-xl bg-rose-50 border border-rose-200 text-rose-800 text-xs font-semibold"></div>

            <!-- Tenant Selection (if Admin or Dev with multiple tenants) -->
            @if (TenantCtx.IsGlobalAdmin || (CurrentUser.IsInRole(SystemRoles.Developer) && Model.AvailableTenants.Count > 1))
            {
                <div>
                    <label asp-for="TenantId" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-2">Target Tenant *</label>
                    <select asp-for="TenantId" required class="w-full py-2.5 px-3.5 bg-white border border-slate-300 rounded-xl text-xs font-semibold text-slate-800 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 focus:outline-none shadow-2xs">
                        @foreach (var t in Model.AvailableTenants)
                        {
                            <option value="@t.Id">@t.Name (@t.Code)</option>
                        }
                    </select>
                    <span asp-validation-for="TenantId" class="text-xs text-rose-600 mt-1 block"></span>
                </div>
            }
            else
            {
                <input type="hidden" asp-for="TenantId" />
            }

            <!-- Task Title -->
            <div>
                <label asp-for="Title" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-2">Task Title *</label>
                <input asp-for="Title" required placeholder="e.g. Implement Multi-Tenant Authentication Guard" class="w-full py-2.5 px-4 bg-white border border-slate-300 rounded-xl text-sm font-semibold text-slate-900 placeholder-slate-400 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 focus:outline-none shadow-2xs" />
                <span asp-validation-for="Title" class="text-xs text-rose-600 mt-1 block"></span>
            </div>

            <!-- Description -->
            <div>
                <label asp-for="Description" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-2">Description & Acceptance Criteria</label>
                <textarea asp-for="Description" rows="4" placeholder="Detailed user story, acceptance tests, and technical notes..." class="w-full p-3.5 bg-white border border-slate-300 rounded-xl text-xs font-medium text-slate-900 placeholder-slate-400 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 focus:outline-none shadow-2xs"></textarea>
                <span asp-validation-for="Description" class="text-xs text-rose-600 mt-1 block"></span>
            </div>

            <!-- Status & Priority Grid -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                    <label asp-for="StatusId" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-2">Status *</label>
                    <select asp-for="StatusId" required class="w-full py-2.5 px-3.5 bg-white border border-slate-300 rounded-xl text-xs font-semibold text-slate-800 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 focus:outline-none shadow-2xs">
                        @foreach (var s in Model.AvailableStatuses)
                        {
                            <option value="@s.Id">@s.Name</option>
                        }
                    </select>
                    <span asp-validation-for="StatusId" class="text-xs text-rose-600 mt-1 block"></span>
                </div>

                <div>
                    <label asp-for="PriorityId" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-2">Priority *</label>
                    <select asp-for="PriorityId" required class="w-full py-2.5 px-3.5 bg-white border border-slate-300 rounded-xl text-xs font-semibold text-slate-800 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 focus:outline-none shadow-2xs">
                        @foreach (var p in Model.AvailablePriorities)
                        {
                            <option value="@p.Id">@p.Name</option>
                        }
                    </select>
                    <span asp-validation-for="PriorityId" class="text-xs text-rose-600 mt-1 block"></span>
                </div>
            </div>

            <!-- Assignee & Parent Task -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                    <label asp-for="AssignedUserId" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-2">Assignee</label>
                    <select asp-for="AssignedUserId" class="w-full py-2.5 px-3.5 bg-white border border-slate-300 rounded-xl text-xs font-semibold text-slate-800 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 focus:outline-none shadow-2xs">
                        <option value="">-- Unassigned --</option>
                        @foreach (var u in Model.AvailableUsers)
                        {
                            <option value="@u.Id">@u.FullName (@u.Email)</option>
                        }
                    </select>
                </div>

                <div>
                    <label asp-for="ParentTaskId" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-2">Parent Task (Optional)</label>
                    <select asp-for="ParentTaskId" class="w-full py-2.5 px-3.5 bg-white border border-slate-300 rounded-xl text-xs font-semibold text-slate-800 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 focus:outline-none shadow-2xs">
                        <option value="">-- No Parent (Root Task) --</option>
                        @foreach (var pt in Model.AvailableParentTasks)
                        {
                            <option value="@pt.Id">@pt.TaskNumber - @pt.Title</option>
                        }
                    </select>
                </div>
            </div>

            <!-- Estimate & Dates -->
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                <div>
                    <label asp-for="EstimatedHours" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-2">Estimate (Hours)</label>
                    <input asp-for="EstimatedHours" type="number" step="0.5" min="0" placeholder="e.g. 8.0" class="w-full py-2.5 px-3.5 bg-white border border-slate-300 rounded-xl text-xs font-semibold text-slate-800 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 focus:outline-none shadow-2xs" />
                </div>

                <div>
                    <label asp-for="StartedOn" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-2">Start Date</label>
                    <input asp-for="StartedOn" type="date" class="w-full py-2.5 px-3.5 bg-white border border-slate-300 rounded-xl text-xs font-semibold text-slate-800 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 focus:outline-none shadow-2xs" />
                </div>

                <div>
                    <label asp-for="EndOn" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-2">Target End Date</label>
                    <input asp-for="EndOn" type="date" class="w-full py-2.5 px-3.5 bg-white border border-slate-300 rounded-xl text-xs font-semibold text-slate-800 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 focus:outline-none shadow-2xs" />
                </div>
            </div>

            <div class="flex items-center justify-end gap-3 pt-6 border-t border-slate-100">
                <a href="/Tasks" class="px-5 py-2.5 rounded-xl bg-white hover:bg-slate-50 text-slate-700 text-xs font-bold border border-slate-200 shadow-2xs transition">Cancel</a>
                <button type="submit" class="px-6 py-2.5 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-bold shadow-md shadow-indigo-500/20 transition">
                    Save and Create Task
                </button>
            </div>
        </form>
    </div>
</div>
