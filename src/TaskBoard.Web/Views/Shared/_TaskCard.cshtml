@model TaskDto

<div class="scrum-task-card bg-white p-4 rounded-2xl cursor-grab active:cursor-grabbing border border-slate-200 shadow-2xs hover:shadow-md hover:border-sky-300 group relative transition-all"
     data-task-id="@Model.Id"
     data-task-number="@Model.TaskNumber"
     data-status-id="@Model.StatusId"
     data-row-version="@(Model.RowVersion != null ? Convert.ToBase64String(Model.RowVersion) : "")">

    <!-- Card Header: Number & Priority -->
    <div class="flex items-center justify-between gap-2 mb-2">
        <a href="/Tasks/Details/@Model.Id" class="task-number font-mono text-xs font-bold text-sky-600 hover:text-sky-700 hover:underline">
            @Model.TaskNumber
        </a>

        <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-bold border"
              style="background-color: @(Model.PriorityColor)15; color: @Model.PriorityColor; border-color: @(Model.PriorityColor)40;">
            @Model.PriorityName
        </span>
    </div>

    <!-- Title -->
    <a href="/Tasks/Details/@Model.Id" class="block text-xs font-bold text-slate-900 group-hover:text-sky-600 line-clamp-2 mb-2 transition leading-snug">
        @Model.Title
    </a>

    <!-- Meta / Indicators -->
    <div class="flex items-center justify-between text-xs text-slate-500 pt-2.5 border-t border-slate-100 mt-2">
        <div class="flex items-center gap-2.5">
            @if (Model.ChildTaskCount > 0)
            {
                <span class="flex items-center gap-1 text-[11px] text-slate-500 font-medium" title="@Model.ChildTaskCount subtasks">
                    <svg class="w-3.5 h-3.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z"></path></svg>
                    <span>@Model.ChildTaskCount</span>
                </span>
            }

            @if (Model.CommentCount > 0)
            {
                <span class="flex items-center gap-1 text-[11px] text-slate-500 font-medium" title="@Model.CommentCount comments">
                    <svg class="w-3.5 h-3.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path></svg>
                    <span>@Model.CommentCount</span>
                </span>
            }

            @if (Model.AttachmentCount > 0)
            {
                <span class="flex items-center gap-1 text-[11px] text-slate-500 font-medium" title="@Model.AttachmentCount attachments">
                    <svg class="w-3.5 h-3.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.172 7l-6.586 6.586a2 2 0 102.828 2.828l6.414-6.586a4 4 0 00-5.656-5.656l-6.415 6.585a6 6 0 108.486 8.486L20.5 13"></path></svg>
                    <span>@Model.AttachmentCount</span>
                </span>
            }
        </div>

        <!-- Assignee Avatar / Unassigned -->
        <div>
            @if (!string.IsNullOrWhiteSpace(Model.AssignedUserName))
            {
                <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-lg bg-slate-100 border border-slate-200 text-slate-700 font-semibold text-[10px]" title="Assigned to @Model.AssignedUserName">
                    <span class="w-3.5 h-3.5 rounded-full bg-sky-600 text-[9px] text-white flex items-center justify-center font-bold uppercase">
                        @Model.AssignedUserName.Substring(0, 1)
                    </span>
                    <span class="truncate max-w-[80px]">@Model.AssignedUserName</span>
                </span>
            }
            else
            {
                <span class="text-slate-400 italic text-[10px]">Unassigned</span>
            }
        </div>
    </div>
</div>
