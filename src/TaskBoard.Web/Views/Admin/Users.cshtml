@model AdminUsersViewModel
@{
    ViewData["Title"] = "User Management";
}

<div class="space-y-6 max-w-7xl mx-auto">
    <div class="flex items-center justify-between">
        <div>
            <h2 class="text-2xl font-black text-slate-900 tracking-tight">System Users & Roles</h2>
            <p class="text-xs text-slate-500 mt-0.5 font-medium">Manage administrators, multi-tenant developers, and organization users.</p>
        </div>

        <a href="/Admin/UsersCreate" class="px-4 py-2 rounded-xl bg-sky-600 hover:bg-sky-700 text-white text-xs font-bold shadow-md shadow-sky-500/20 transition">
            + Create New User
        </a>
    </div>

    <!-- Filter Bar -->
    <div class="bg-white p-4 rounded-2xl border border-slate-200 shadow-sm">
        <form method="get" class="flex items-center gap-3 flex-wrap">
            <input type="text" name="Search" value="@Model.Filter.Search" placeholder="Search by name, email, or username..." class="w-72 py-2 px-3 bg-white border border-slate-300 rounded-xl text-xs font-medium text-slate-900 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-sky-500 focus:border-sky-500 shadow-2xs" />
            
            @{
                var currentT = Model.AvailableTenants.FirstOrDefault(t => t.Id == Model.SelectedTenantId);
                var currentTVal = Model.SelectedTenantId?.ToString() ?? "";
                var currentTLabel = currentT != null ? $"{currentT.Name} ({currentT.Code})" : "All Tenants";
            }
            <div class="relative" x-data="{ open: false, selectedVal: '@currentTVal', selectedLabel: '@currentTLabel' }">
                <input type="hidden" name="tenantId" :value="selectedVal" />
                
                <button type="button" 
                        @@click="open = !open" 
                        @@click.outside="open = false" 
                        class="flex items-center justify-between gap-2.5 py-2 px-3 bg-white border border-slate-300 hover:border-sky-300 rounded-xl text-xs font-medium text-slate-700 focus:outline-none focus:ring-2 focus:ring-sky-500 shadow-2xs transition min-w-[180px] text-left">
                    <span x-text="selectedLabel" class="truncate"></span>
                    <svg class="w-4 h-4 text-slate-400 shrink-0 transition-transform duration-200" :class="open ? 'rotate-180 text-sky-600' : ''" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                </button>

                <div x-show="open" 
                     x-cloak
                     x-transition:enter="transition ease-out duration-100"
                     x-transition:enter-start="transform opacity-0 scale-95"
                     x-transition:enter-end="transform opacity-100 scale-100"
                     x-transition:leave="transition ease-in duration-75"
                     x-transition:leave-start="transform opacity-100 scale-100"
                     x-transition:leave-end="transform opacity-0 scale-95"
                     class="absolute left-0 mt-1.5 w-60 rounded-2xl bg-white border border-slate-200 shadow-xl py-1.5 z-50 max-h-56 overflow-y-auto">
                    <button type="button" 
                            @@click="selectedVal = ''; selectedLabel = 'All Tenants'; open = false" 
                            class="w-full flex items-center justify-between px-3.5 py-2 text-xs font-medium hover:bg-sky-50 hover:text-sky-700 transition"
                            :class="selectedVal === '' ? 'bg-sky-50/80 text-sky-700 font-bold' : 'text-slate-700'">
                        <span>All Tenants</span>
                        <span x-show="selectedVal === ''" class="text-sky-600 font-bold">&check;</span>
                    </button>
                    @foreach (var t in Model.AvailableTenants)
                    {
                        <button type="button" 
                                @@click="selectedVal = '@t.Id'; selectedLabel = '@t.Name (@t.Code)'; open = false" 
                                class="w-full flex items-center justify-between px-3.5 py-2 text-xs font-medium hover:bg-sky-50 hover:text-sky-700 transition"
                                :class="selectedVal === '@t.Id' ? 'bg-sky-50/80 text-sky-700 font-bold' : 'text-slate-700'">
                            <span class="truncate">@t.Name (@t.Code)</span>
                            <span x-show="selectedVal === '@t.Id'" class="text-sky-600 font-bold">&check;</span>
                        </button>
                    }
                </div>
            </div>

            <button type="submit" class="px-4 py-2 bg-sky-50 hover:bg-sky-100 text-sky-700 border border-sky-200 text-xs font-bold rounded-xl transition">Filter</button>
            <a href="/Admin/Users" class="text-xs font-medium text-slate-500 hover:text-slate-900">Reset</a>
        </form>
    </div>

    <!-- Users Table -->
    <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
        @if (Model.Users.Items.Count == 0)
        {
            <div class="p-8">
                <partial name="_EmptyState" model="@("No users found.")" />
            </div>
        }
        else
        {
            <div class="overflow-x-auto">
                <table class="w-full text-left text-xs text-slate-700">
                    <thead class="bg-slate-50 text-slate-500 uppercase font-bold text-[10px] tracking-wider border-b border-slate-200">
                        <tr>
                            <th class="py-3.5 px-6">User</th>
                            <th class="py-3.5 px-6">Username</th>
                            <th class="py-3.5 px-6">Role</th>
                            <th class="py-3.5 px-6">Assigned Tenants</th>
                            <th class="py-3.5 px-6">Status</th>
                            <th class="py-3.5 px-6">Created On</th>
                            <th class="py-3.5 px-6 text-right">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100">
                        @foreach (var user in Model.Users.Items)
                        {
                            <tr class="hover:bg-slate-50/80 transition">
                                <td class="py-3.5 px-6">
                                    <div class="font-bold text-slate-900">@user.FullName</div>
                                    <div class="text-[10px] text-slate-500 font-medium">@user.Email</div>
                                </td>
                                <td class="py-3.5 px-6 font-mono font-semibold text-slate-700">@user.Username</td>
                                <td class="py-3.5 px-6">
                                    @foreach (var role in user.Roles)
                                    {
                                        var roleBadge = role == SystemRoles.Admin 
                                            ? "bg-purple-50 text-purple-700 border-purple-200" 
                                            : role == SystemRoles.Developer 
                                                ? "bg-emerald-50 text-emerald-700 border-emerald-200" 
                                                : "bg-sky-50 text-sky-700 border-sky-200";
                                        
                                        <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold border @roleBadge">@role</span>
                                    }
                                </td>
                                <td class="py-3.5 px-6">
                                    @if (user.AssignedTenants.Count == 0)
                                    {
                                        <span class="text-slate-400 italic font-medium">None (Global Admin)</span>
                                    }
                                    else
                                    {
                                        <div class="flex flex-wrap gap-1">
                                            @foreach (var at in user.AssignedTenants)
                                            {
                                                <span class="px-2 py-0.5 rounded bg-slate-100 border border-slate-200 text-[10px] font-mono font-bold text-slate-700">
                                                    @at.Code
                                                </span>
                                            }
                                        </div>
                                    }
                                </td>
                                <td class="py-3.5 px-6">
                                    <div class="flex flex-col gap-1 items-start">
                                        @if (!user.IsActive)
                                        {
                                            <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-rose-50 text-rose-700 border border-rose-200">Deactivated</span>
                                        }
                                        else if (user.IsLockedOut)
                                        {
                                            <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-amber-50 text-amber-800 border border-amber-300 flex items-center gap-1">
                                                <svg class="w-3 h-3 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path></svg>
                                                <span>Locked @(user.FailedLoginAttempts >= 5 ? "(5 attempts)" : "")</span>
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-emerald-50 text-emerald-700 border border-emerald-200">Active</span>
                                        }

                                        @if (user.MustChangePassword)
                                        {
                                            <span class="px-2 py-0.5 rounded-full text-[9px] font-bold bg-sky-50 text-sky-700 border border-sky-200">
                                                Password Reset Required
                                            </span>
                                        }
                                    </div>
                                </td>
                                <td class="py-3.5 px-6 text-slate-500 font-medium">@user.CreatedOn.ToString("MMM dd, yyyy")</td>
                                <td class="py-3.5 px-6 text-right">
                                    <div class="relative inline-block text-left" x-data="{ actionOpen: false }">
                                        <button type="button" 
                                                @@click="actionOpen = !actionOpen" 
                                                @@click.outside="actionOpen = false" 
                                                class="px-2.5 py-1.5 bg-white hover:bg-slate-50 border border-slate-200 text-slate-700 rounded-xl text-xs font-bold shadow-2xs transition inline-flex items-center gap-1.5">
                                            <span>Actions</span>
                                            <svg class="w-3.5 h-3.5 text-slate-400 transition-transform" :class="actionOpen ? 'rotate-180 text-sky-600' : ''" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                                        </button>

                                        <div x-show="actionOpen" 
                                             x-cloak
                                             x-transition:enter="transition ease-out duration-100"
                                             x-transition:enter-start="transform opacity-0 scale-95"
                                             x-transition:enter-end="transform opacity-100 scale-100"
                                             x-transition:leave="transition ease-in duration-75"
                                             x-transition:leave-start="transform opacity-100 scale-100"
                                             x-transition:leave-end="transform opacity-0 scale-95"
                                             class="absolute right-0 mt-1.5 w-52 rounded-2xl bg-white border border-slate-200 shadow-xl py-1.5 z-50 text-left">
                                            
                                            <a href="/Admin/UsersEdit/@user.Id" class="flex items-center gap-2 px-3.5 py-2 text-xs font-semibold text-slate-700 hover:bg-sky-50 hover:text-sky-700 transition">
                                                <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path></svg>
                                                <span>Edit User Profile</span>
                                            </a>

                                            <!-- Toggle Lock / Unlock -->
                                            <form asp-action="UsersToggleLock" asp-route-id="@user.Id" method="post">
                                                <button type="submit" class="w-full flex items-center gap-2 px-3.5 py-2 text-xs font-semibold hover:bg-amber-50 hover:text-amber-700 transition text-left @(user.IsLockedOut ? "text-emerald-700 font-bold" : "text-amber-700")">
                                                    <svg class="w-4 h-4 text-amber-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path></svg>
                                                    <span>@(user.IsLockedOut ? "Unlock Account" : "Lock Account")</span>
                                                </button>
                                            </form>

                                            <!-- Force Password Reset -->
                                            <form asp-action="UsersForcePasswordReset" asp-route-id="@user.Id" method="post">
                                                <button type="submit" class="w-full flex items-center gap-2 px-3.5 py-2 text-xs font-semibold text-slate-700 hover:bg-sky-50 hover:text-sky-700 transition text-left">
                                                    <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"></path></svg>
                                                    <span>Force Password Reset</span>
                                                </button>
                                            </form>

                                            <!-- Revoke Sessions & Force Logout -->
                                            <form asp-action="UsersRevokeSessions" asp-route-id="@user.Id" method="post" onsubmit="return confirm('Revoke all active sessions and force logout for this user?');">
                                                <button type="submit" class="w-full flex items-center gap-2 px-3.5 py-2 text-xs font-semibold text-rose-600 hover:bg-rose-50 transition text-left">
                                                    <svg class="w-4 h-4 text-rose-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path></svg>
                                                    <span>Revoke Sessions (Force Logout)</span>
                                                </button>
                                            </form>

                                            <div class="border-t border-slate-100 my-1"></div>

                                            <!-- Toggle Status (Activate / Deactivate) -->
                                            <form asp-action="UsersToggleStatus" asp-route-id="@user.Id" method="post">
                                                <button type="submit" class="w-full flex items-center gap-2 px-3.5 py-2 text-xs font-semibold hover:bg-slate-100 text-slate-600 transition text-left">
                                                    <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636"></path></svg>
                                                    <span>@(user.IsActive ? "Deactivate User" : "Activate User")</span>
                                                </button>
                                            </form>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <partial name="_Pagination" model="Model.Users" />
        }
    </div>
</div>
