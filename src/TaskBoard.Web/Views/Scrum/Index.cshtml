@model ScrumBoardViewModel
@inject TaskBoard.Application.Security.ITenantContext TenantCtx
@inject TaskBoard.Application.Security.ICurrentUserService CurrentUser
@{
    ViewData["Title"] = "Scrum Board";
}

<div class="h-full flex flex-col space-y-5">
    <!-- Board Header & Filters -->
    <div class="flex items-center justify-between flex-wrap gap-4 shrink-0">
        <div>
            <div class="flex items-center gap-3">
                <h2 class="text-2xl font-black text-slate-900 tracking-tight">Agile Scrum Board</h2>
                @if (!string.IsNullOrEmpty(Model.SelectedTenantName))
                {
                    <span class="px-2.5 py-0.5 rounded-lg bg-indigo-50 border border-indigo-200 text-indigo-700 font-mono text-xs font-bold">
                        @Model.SelectedTenantName
                    </span>
                }
            </div>
            <p class="text-xs text-slate-500 mt-0.5 font-medium">Drag and drop task cards horizontally across sprint workflow columns.</p>
        </div>

        <div class="flex items-center gap-3">
            @if (Model.AvailableTenants.Count > 0)
            {
                <form method="get" asp-action="Index" class="flex items-center gap-2">
                    <select name="tenantId" onchange="this.form.submit()" class="bg-white border border-slate-300 text-xs font-semibold text-slate-700 rounded-xl px-3 py-2 shadow-2xs focus:ring-2 focus:ring-indigo-500 focus:outline-none transition">
                        <option value="">-- Switch Tenant Board --</option>
                        @foreach (var t in Model.AvailableTenants)
                        {
                            <option value="@t.Id" selected="@(Model.SelectedTenantId == t.Id)">@t.Name (@t.Code)</option>
                        }
                    </select>
                </form>
            }

            <a href="/Tasks/Create@(Model.SelectedTenantId.HasValue ? $"?tenantId={Model.SelectedTenantId.Value}" : "")" class="px-4 py-2 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-bold shadow-md shadow-indigo-500/20 transition flex items-center gap-2">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
                Add Task
            </a>
        </div>
    </div>

    <!-- Hidden Antiforgery Token for AJAX Drag-and-Drop mutations -->
    @Html.AntiForgeryToken()

    @if (Model.Board == null || Model.Board.Columns.Count == 0)
    {
        <div class="p-12">
            <partial name="_EmptyState" model="@("No active Scrum Board columns configured. Please contact your system administrator.")" />
        </div>
    }
    else
    {
        <!-- Scrum Columns Grid (Horizontal Scrollable) -->
        <div id="scrum-board-container" class="flex-1 flex gap-5 overflow-x-auto pb-4 items-start select-none min-h-[550px]">
            @foreach (var column in Model.Board.Columns.OrderBy(c => c.DisplayOrder))
            {
                <div class="scrum-column w-80 shrink-0 bg-slate-100/90 border border-slate-200/90 rounded-2xl flex flex-col max-h-full shadow-sm"
                     data-column-id="@column.Id"
                     data-column-name="@column.Name"
                     data-wip-limit="@(column.WipLimit ?? 0)">

                    <!-- Column Header -->
                    <div class="p-3.5 border-b border-slate-200/80 bg-white/60 rounded-t-2xl flex items-center justify-between">
                        <div class="flex items-center gap-2.5 min-w-0">
                            <span class="w-2.5 h-2.5 rounded-full shadow-2xs" style="background-color: @column.StatusColor;"></span>
                            <h3 class="text-xs font-bold uppercase tracking-wider text-slate-800 truncate">@column.Name</h3>
                        </div>

                        <div class="flex items-center gap-2">
                            @if (column.WipLimit.HasValue && column.WipLimit.Value > 0)
                            {
                                <span class="text-[10px] font-mono text-slate-500 font-semibold" title="WIP Limit: @column.WipLimit.Value">
                                    WIP: @column.WipLimit.Value
                                </span>
                            }

                            <span class="column-task-count px-2 py-0.5 rounded-full bg-white text-[11px] font-bold text-indigo-600 border border-slate-200 shadow-2xs">
                                @column.Tasks.Count
                            </span>
                        </div>
                    </div>

                    <!-- WIP Limit Exceeded Warning Badge -->
                    <div class="wip-limit-warning hidden px-4 py-1.5 bg-rose-50 border-b border-rose-200 text-rose-700 text-[10px] font-bold uppercase tracking-wider text-center">
                        WIP Limit Exceeded!
                    </div>

                    <!-- Column Body / Drop Zone -->
                    <div class="scrum-drop-zone flex-1 p-3 space-y-3 overflow-y-auto min-h-[400px] transition-colors rounded-b-2xl"
                         data-status-id="@column.StatusId">

                        @foreach (var task in column.Tasks)
                        {
                            <partial name="_TaskCard" model="task" />
                        }

                        @if (column.Tasks.Count == 0)
                        {
                            <div class="empty-column-placeholder h-24 border border-dashed border-slate-300 rounded-xl flex items-center justify-center text-slate-400 text-xs italic bg-white/40">
                                Drop task here
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    }
</div>

@section Scripts {
    <script src="~/js/scrum-board.js" asp-append-version="true"></script>
}
