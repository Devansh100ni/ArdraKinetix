@model AdminUserCreateEditViewModel
@{
    ViewData["Title"] = "Create User";
}

<div class="max-w-2xl mx-auto space-y-6">
    <div class="flex items-center justify-between">
        <div>
            <h2 class="text-2xl font-black text-slate-900 tracking-tight">Create User</h2>
            <p class="text-xs text-slate-500 mt-0.5 font-medium">Register user credentials, assign system role, and link accessible tenants.</p>
        </div>
        <a href="/Admin/Users" class="text-xs font-bold text-indigo-600 hover:text-indigo-700">&larr; Back to Users</a>
    </div>

    <div class="bg-white p-8 rounded-3xl border border-slate-200 shadow-sm">
        <form asp-action="UsersCreate" method="post" class="space-y-5">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="p-4 rounded-xl bg-rose-50 border border-rose-200 text-rose-800 text-xs font-semibold"></div>

            <div class="grid grid-cols-2 gap-4">
                <div>
                    <label asp-for="FirstName" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-2">First Name *</label>
                    <input asp-for="FirstName" required class="w-full py-2.5 px-3.5 bg-white border border-slate-300 rounded-xl text-xs font-semibold text-slate-900 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 focus:outline-none shadow-2xs" />
                    <span asp-validation-for="FirstName" class="text-xs text-rose-600 mt-1 block"></span>
                </div>
                <div>
                    <label asp-for="LastName" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-2">Last Name *</label>
                    <input asp-for="LastName" required class="w-full py-2.5 px-3.5 bg-white border border-slate-300 rounded-xl text-xs font-semibold text-slate-900 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 focus:outline-none shadow-2xs" />
                    <span asp-validation-for="LastName" class="text-xs text-rose-600 mt-1 block"></span>
                </div>
            </div>

            <div class="grid grid-cols-2 gap-4">
                <div>
                    <label asp-for="Username" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-2">Username *</label>
                    <input asp-for="Username" required class="w-full py-2.5 px-3.5 bg-white border border-slate-300 rounded-xl text-xs font-semibold text-slate-900 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 focus:outline-none shadow-2xs" />
                    <span asp-validation-for="Username" class="text-xs text-rose-600 mt-1 block"></span>
                </div>
                <div>
                    <label asp-for="Email" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-2">Email Address *</label>
                    <input asp-for="Email" type="email" required class="w-full py-2.5 px-3.5 bg-white border border-slate-300 rounded-xl text-xs font-semibold text-slate-900 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 focus:outline-none shadow-2xs" />
                    <span asp-validation-for="Email" class="text-xs text-rose-600 mt-1 block"></span>
                </div>
            </div>

            <div class="grid grid-cols-2 gap-4">
                <div>
                    <label asp-for="Password" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-2">Password *</label>
                    <input asp-for="Password" type="password" required class="w-full py-2.5 px-3.5 bg-white border border-slate-300 rounded-xl text-xs font-semibold text-slate-900 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 focus:outline-none shadow-2xs" />
                    <span asp-validation-for="Password" class="text-xs text-rose-600 mt-1 block"></span>
                </div>
                <div>
                    <label asp-for="ConfirmPassword" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-2">Confirm Password *</label>
                    <input asp-for="ConfirmPassword" type="password" required class="w-full py-2.5 px-3.5 bg-white border border-slate-300 rounded-xl text-xs font-semibold text-slate-900 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 focus:outline-none shadow-2xs" />
                    <span asp-validation-for="ConfirmPassword" class="text-xs text-rose-600 mt-1 block"></span>
                </div>
            </div>

            <div>
                <label asp-for="Role" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-2">System Role *</label>
                <select asp-for="Role" required class="w-full py-2.5 px-3.5 bg-white border border-slate-300 rounded-xl text-xs font-semibold text-slate-800 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 focus:outline-none shadow-2xs">
                    @foreach (var r in Model.AvailableRoles)
                    {
                        <option value="@r.Name">@r.Name - @r.Description</option>
                    }
                </select>
                <span asp-validation-for="Role" class="text-xs text-rose-600 mt-1 block"></span>
            </div>

            <div>
                <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-2">Assigned Tenants (Multi-select for Developers, Single for Tenant User)</label>
                <div class="grid grid-cols-2 gap-2 p-3 bg-slate-50 border border-slate-200 rounded-xl max-h-48 overflow-y-auto">
                    @foreach (var t in Model.AvailableTenants)
                    {
                        <label class="flex items-center gap-2 text-xs text-slate-700 hover:text-slate-900 cursor-pointer select-none p-1.5 rounded-lg hover:bg-white transition">
                            <input type="checkbox" name="AssignedTenantIds" value="@t.Id" class="w-4 h-4 rounded border-slate-300 text-indigo-600 focus:ring-indigo-500" />
                            <span>@t.Name (<span class="font-mono text-indigo-600 font-bold">@t.Code</span>)</span>
                        </label>
                    }
                </div>
            </div>

            <div class="flex items-center gap-2 pt-2">
                <input asp-for="IsActive" type="checkbox" class="w-4 h-4 rounded border-slate-300 text-indigo-600 focus:ring-indigo-500" />
                <label asp-for="IsActive" class="text-xs text-slate-700 font-medium">Account is active</label>
            </div>

            <div class="flex items-center justify-end gap-3 pt-6 border-t border-slate-100">
                <a href="/Admin/Users" class="px-5 py-2.5 rounded-xl bg-white hover:bg-slate-50 text-slate-700 text-xs font-bold border border-slate-200 shadow-2xs transition">Cancel</a>
                <button type="submit" class="px-6 py-2.5 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-bold shadow-md shadow-indigo-500/20 transition">Create User Account</button>
            </div>
        </form>
    </div>
</div>
