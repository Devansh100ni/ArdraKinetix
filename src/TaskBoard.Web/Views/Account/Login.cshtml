        <div class="max-w-7xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-2 text-xs text-slate-500">
            <div class="flex items-center gap-2">
                <img src="~/images/ArdraKinetiX.png" alt="ArdraKinetix" class="h-5 w-auto object-contain opacity-75" asp-append-version="true" />
                <span>&copy; @DateTime.UtcNow.Year ArdraKinetix Enterprise. All rights reserved.</span>
            </div>
            <div class="flex items-center gap-4 font-semibold text-[11px]">
                <span class="text-sky-600">Co-powered by CodeArdra Solutions</span>
                <span>&bull;</span>
                <a href="/" class="hover:text-sky-600 transition">Home</a>
                <span>&bull;</span>
                <a href="#" class="hover:text-sky-600 transition">Privacy Policy</a>
            </div>
        </div>
    </footer>

    <!-- ========================================== -->
    <!-- SCRIPTS: GSAP, ALPINE & LOGIN CLIENT LOGIC -->
