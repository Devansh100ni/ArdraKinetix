@model AdminUserCreateEditViewModel
@{
    ViewData["Title"] = "Create User";
}

<div class="max-w-2xl mx-auto space-y-6">
    <div class="flex items-center justify-between">
        <div>
            <h2 class="text-2xl font-black text-slate-900 tracking-tight">Create User</h2>
            <p class="text-xs text-slate-500 mt-0.5 font-medium">Register user credentials, assign system role, and link accessible tenants.</p>
        </div>
        <a href="/Admin/Users" class="text-xs font-bold text-sky-600 hover:text-sky-700">&larr; Back to Users</a>
    </div>

    <div class="bg-white p-8 rounded-3xl border border-slate-200 shadow-sm">
        <form asp-action="UsersCreate" method="post" class="space-y-5">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="p-4 rounded-xl bg-rose-50 border border-rose-200 text-rose-800 text-xs font-semibold"></div>

            <div class="grid grid-cols-2 gap-4">
                <div>
                    <label asp-for="FirstName" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-2">First Name *</label>
                    <input asp-for="FirstName" required class="w-full py-2.5 px-3.5 bg-white border border-slate-300 rounded-xl text-xs font-semibold text-slate-900 focus:ring-2 focus:ring-sky-500 focus:border-sky-500 focus:outline-none shadow-2xs" />
                    <span asp-validation-for="FirstName" class="text-xs text-rose-600 mt-1 block"></span>
                </div>
                <div>
                    <label asp-for="LastName" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-2">Last Name *</label>
                    <input asp-for="LastName" required class="w-full py-2.5 px-3.5 bg-white border border-slate-300 rounded-xl text-xs font-semibold text-slate-900 focus:ring-2 focus:ring-sky-500 focus:border-sky-500 focus:outline-none shadow-2xs" />
                    <span asp-validation-for="LastName" class="text-xs text-rose-600 mt-1 block"></span>
                </div>
            </div>

            <div class="grid grid-cols-2 gap-4">
                <div>
                    <label asp-for="Username" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-2">Username *</label>
                    <input asp-for="Username" required class="w-full py-2.5 px-3.5 bg-white border border-slate-300 rounded-xl text-xs font-semibold text-slate-900 focus:ring-2 focus:ring-sky-500 focus:border-sky-500 focus:outline-none shadow-2xs" />
                    <span asp-validation-for="Username" class="text-xs text-rose-600 mt-1 block"></span>
                </div>
                <div>
                    <label asp-for="Email" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-2">Email Address *</label>
                    <input asp-for="Email" type="email" required class="w-full py-2.5 px-3.5 bg-white border border-slate-300 rounded-xl text-xs font-semibold text-slate-900 focus:ring-2 focus:ring-sky-500 focus:border-sky-500 focus:outline-none shadow-2xs" />
                    <span asp-validation-for="Email" class="text-xs text-rose-600 mt-1 block"></span>
                </div>
            </div>

            <div class="grid grid-cols-2 gap-4">
                <div>
                    <label asp-for="Password" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-2">Password *</label>
                    <input asp-for="Password" type="password" required class="w-full py-2.5 px-3.5 bg-white border border-slate-300 rounded-xl text-xs font-semibold text-slate-900 focus:ring-2 focus:ring-sky-500 focus:border-sky-500 focus:outline-none shadow-2xs" />
                    <span asp-validation-for="Password" class="text-xs text-rose-600 mt-1 block"></span>
                </div>
                <div>
                    <label asp-for="ConfirmPassword" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-2">Confirm Password *</label>
                    <input asp-for="ConfirmPassword" type="password" required class="w-full py-2.5 px-3.5 bg-white border border-slate-300 rounded-xl text-xs font-semibold text-slate-900 focus:ring-2 focus:ring-sky-500 focus:border-sky-500 focus:outline-none shadow-2xs" />
                    <span asp-validation-for="ConfirmPassword" class="text-xs text-rose-600 mt-1 block"></span>
                </div>
            </div>

            @{
                var defaultRole = Model.AvailableRoles.FirstOrDefault(r => r.Name == Model.Role) ?? Model.AvailableRoles.FirstOrDefault();
                var defaultRoleVal = defaultRole?.Name ?? "";
                var defaultRoleLabel = defaultRole != null ? $"{defaultRole.Name} - {defaultRole.Description}" : "Select Role";
            }
            <div class="relative" x-data="{ open: false, selectedVal: '@defaultRoleVal', selectedLabel: '@defaultRoleLabel' }">
                <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-2">System Role *</label>
                <input type="hidden" name="Role" :value="selectedVal" required />
                
                <button type="button" 
                        @@click="open = !open" 
                        @@click.outside="open = false" 
                        class="w-full flex items-center justify-between py-2.5 px-3.5 bg-white border border-slate-300 hover:border-sky-300 rounded-xl text-xs font-semibold text-slate-800 focus:ring-2 focus:ring-sky-500 focus:outline-none shadow-2xs transition text-left">
                    <span x-text="selectedLabel" class="truncate"></span>
                    <svg class="w-4 h-4 text-slate-400 shrink-0 transition-transform duration-200" :class="open ? 'rotate-180 text-sky-600' : ''" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                </button>

                <div x-show="open" 
                     x-cloak
                     x-transition:enter="transition ease-out duration-100"
                     x-transition:enter-start="transform opacity-0 scale-95"
                     x-transition:enter-end="transform opacity-100 scale-100"
                     x-transition:leave="transition ease-in duration-75"
                     x-transition:leave-start="transform opacity-100 scale-100"
                     x-transition:leave-end="transform opacity-0 scale-95"
                     class="absolute left-0 mt-1.5 w-full rounded-2xl bg-white border border-slate-200 shadow-xl py-1.5 z-50 max-h-56 overflow-y-auto">
                    @foreach (var r in Model.AvailableRoles)
                    {
                        <button type="button" 
                                @@click="selectedVal = '@r.Name'; selectedLabel = '@r.Name - @r.Description'; open = false" 
                                class="w-full flex items-center justify-between px-3.5 py-2.5 text-xs font-medium hover:bg-sky-50 hover:text-sky-700 transition"
                                :class="selectedVal === '@r.Name' ? 'bg-sky-50/80 text-sky-700 font-bold' : 'text-slate-700'">
                            <div>
                                <span class="font-bold text-slate-900">@r.Name</span>
                                <span class="text-slate-500 ml-1.5 text-[11px] font-normal">- @r.Description</span>
                            </div>
                            <span x-show="selectedVal === '@r.Name'" class="text-sky-600 font-bold">&check;</span>
                        </button>
                    }
                </div>
                <span asp-validation-for="Role" class="text-xs text-rose-600 mt-1 block"></span>
            </div>

            <div>
                <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-2">Assigned Tenants (Multi-select for Developers, Single for Tenant User)</label>
                <div class="grid grid-cols-2 gap-2 p-3 bg-slate-50 border border-slate-200 rounded-xl max-h-48 overflow-y-auto">
                    @foreach (var t in Model.AvailableTenants)
                    {
                        <label class="flex items-center gap-2 text-xs text-slate-700 hover:text-slate-900 cursor-pointer select-none p-1.5 rounded-lg hover:bg-white transition">
                            <input type="checkbox" name="AssignedTenantIds" value="@t.Id" class="w-4 h-4 rounded border-slate-300 text-sky-600 focus:ring-sky-500" />
                            <span>@t.Name (<span class="font-mono text-sky-600 font-bold">@t.Code</span>)</span>
                        </label>
                    }
                </div>
            </div>

            <div class="flex items-center gap-2 pt-2">
                <input asp-for="IsActive" type="checkbox" class="w-4 h-4 rounded border-slate-300 text-sky-600 focus:ring-sky-500" />
                <label asp-for="IsActive" class="text-xs text-slate-700 font-medium">Account is active</label>
            </div>

            <div class="flex items-center justify-end gap-3 pt-6 border-t border-slate-100">
                <a href="/Admin/Users" class="px-5 py-2.5 rounded-xl bg-white hover:bg-slate-50 text-slate-700 text-xs font-bold border border-slate-200 shadow-2xs transition">Cancel</a>
                <button type="submit" class="px-6 py-2.5 rounded-xl bg-sky-600 hover:bg-sky-700 text-white text-xs font-bold shadow-md shadow-sky-500/20 transition">Create User Account</button>
            </div>
        </form>
    </div>
</div>
