@model TenantDashboardDto

<!-- Tenant Dashboard Header -->
<div class="flex items-center justify-between">
    <div>
        <div class="flex items-center gap-3">
            <h2 class="text-2xl font-black text-slate-900 tracking-tight">@Model.TenantName</h2>
            <span class="px-2.5 py-0.5 rounded-lg bg-sky-50 border border-sky-200 text-sky-700 font-mono text-xs font-bold">
                @Model.TenantCode
            </span>
        </div>
        <p class="text-xs text-slate-500 mt-0.5 font-medium">Scrum roadmap and task delivery metrics for your organization.</p>
    </div>

    <div class="flex items-center gap-3">
        <a href="/Tasks/Create" class="px-4 py-2 rounded-xl bg-sky-600 hover:bg-sky-700 text-white text-xs font-bold shadow-md shadow-sky-500/20 transition">
            + New Task
        </a>
    </div>
</div>

<!-- Key Stat Cards -->
<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-5">
    <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm">
        <div class="text-xs font-bold uppercase tracking-wider text-slate-500 mb-2">Total Tasks</div>
        <div class="text-3xl font-black text-slate-900">@Model.TotalTasks</div>
        <div class="text-[11px] text-slate-500 mt-2 font-medium">All tasks in backlog & sprint</div>
    </div>

    <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm">
        <div class="text-xs font-bold uppercase tracking-wider text-slate-500 mb-2">Open / In Progress</div>
        <div class="text-3xl font-black text-amber-600">@Model.OpenTasks</div>
        <div class="text-[11px] text-amber-700 mt-2 font-semibold">Active work items</div>
    </div>

    <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm">
        <div class="text-xs font-bold uppercase tracking-wider text-slate-500 mb-2">Completed Tasks</div>
        <div class="text-3xl font-black text-emerald-600">@Model.CompletedTasks</div>
        <div class="text-[11px] text-emerald-700 mt-2 font-semibold">Successfully delivered</div>
    </div>

    <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm">
        <div class="text-xs font-bold uppercase tracking-wider text-slate-500 mb-2">Overdue Tasks</div>
        <div class="text-3xl font-black text-rose-600">@Model.OverdueTasksCount</div>
        <div class="text-[11px] text-rose-700 mt-2 font-semibold">Passed target date</div>
    </div>
</div>

<!-- Status & Priority Breakdown -->
<div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
    <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm">
        <h3 class="text-xs font-bold text-slate-800 uppercase tracking-wider mb-4">Task Status Distribution</h3>
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-3">
            @foreach (var (status, count) in Model.TasksByStatus)
            {
                <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-200/80">
                    <div class="text-xs font-semibold text-slate-500 truncate">@status</div>
                    <div class="text-xl font-black text-slate-900 mt-1">@count</div>
                </div>
            }
        </div>
    </div>

    <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm">
        <h3 class="text-xs font-bold text-slate-800 uppercase tracking-wider mb-4">Priority Breakdown</h3>
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
            @foreach (var (priority, count) in Model.TasksByPriority)
            {
                <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-200/80">
                    <div class="text-xs font-semibold text-slate-500 truncate">@priority</div>
                    <div class="text-xl font-black text-slate-900 mt-1">@count</div>
                </div>
            }
        </div>
    </div>
</div>

<!-- Recent Tasks Table -->
<div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
    <div class="p-6 border-b border-slate-100 flex items-center justify-between">
        <div>
            <h3 class="text-base font-bold text-slate-900">Recent Organization Tasks</h3>
            <p class="text-xs text-slate-500 mt-0.5">Tasks created for @Model.TenantName.</p>
        </div>
        <a href="/Tasks" class="text-xs font-bold text-sky-600 hover:text-sky-700">View All Tasks &rarr;</a>
    </div>

    @if (Model.RecentTasks.Count == 0)
    {
        <div class="p-8">
            <partial name="_EmptyState" model="@("No tasks found for your organization.")" />
        </div>
    }
    else
    {
        <div class="overflow-x-auto">
            <table class="w-full text-left text-xs text-slate-700">
                <thead class="bg-slate-50 text-slate-500 uppercase font-bold text-[10px] tracking-wider border-b border-slate-200">
                    <tr>
                        <th class="py-3.5 px-6">Task</th>
                        <th class="py-3.5 px-6">Status</th>
                        <th class="py-3.5 px-6">Priority</th>
                        <th class="py-3.5 px-6">Assignee</th>
                        <th class="py-3.5 px-6">Created On</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    @foreach (var task in Model.RecentTasks)
                    {
                        <tr class="hover:bg-slate-50/80 transition">
                            <td class="py-3.5 px-6 font-medium">
                                <a href="/Tasks/Details/@task.Id" class="font-mono font-bold text-sky-600 hover:underline mr-2">@task.TaskNumber</a>
                                <span class="text-slate-800 font-medium">@task.Title</span>
                            </td>
                            <td class="py-3.5 px-6">
                                <span class="px-2.5 py-0.5 rounded-full text-[11px] font-bold border"
                                      style="background-color: @(task.StatusColor)15; color: @task.StatusColor; border-color: @(task.StatusColor)40;">
                                    @task.StatusName
                                </span>
                            </td>
                            <td class="py-3.5 px-6">
                                <span class="px-2.5 py-0.5 rounded-full text-[11px] font-bold border"
                                      style="background-color: @(task.PriorityColor)15; color: @task.PriorityColor; border-color: @(task.PriorityColor)40;">
                                    @task.PriorityName
                                </span>
                            </td>
                            <td class="py-3.5 px-6 font-medium text-slate-700">
                                @(task.AssignedUserName ?? "Unassigned")
                            </td>
                            <td class="py-3.5 px-6 text-slate-500 font-medium">
                                @task.CreatedOn.ToString("MMM dd, yyyy HH:mm")
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
