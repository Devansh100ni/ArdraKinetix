@model TaskCreateEditViewModel
@{
    ViewData["Title"] = $"Edit {Model.TaskNumber}";
}

<div class="max-w-3xl mx-auto space-y-6">
    <div class="flex items-center justify-between">
        <div>
            <div class="flex items-center gap-2">
                <span class="font-mono text-xs font-bold text-indigo-600">@Model.TaskNumber</span>
                <span class="text-xs text-slate-400">&bull;</span>
                <h2 class="text-2xl font-black text-slate-900 tracking-tight">Edit Task</h2>
            </div>
            <p class="text-xs text-slate-500 mt-0.5 font-medium">Modify task details, assignee, dates, or workflow status.</p>
        </div>
        <a href="/Tasks/Details/@Model.Id" class="text-xs font-bold text-indigo-600 hover:text-indigo-700">&larr; Back to Details</a>
    </div>

    <div class="bg-white p-8 rounded-3xl border border-slate-200 shadow-sm">
        <form asp-action="Edit" method="post" class="space-y-6">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="TenantId" />
            <input type="hidden" asp-for="TaskNumber" />
            <input type="hidden" name="RowVersion" value="@(Model.RowVersion != null ? Convert.ToBase64String(Model.RowVersion) : "")" />

            <div asp-validation-summary="ModelOnly" class="p-4 rounded-xl bg-rose-50 border border-rose-200 text-rose-800 text-xs font-semibold"></div>

            <!-- Task Title -->
            <div>
                <label asp-for="Title" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-2">Task Title *</label>
                <input asp-for="Title" required class="w-full py-2.5 px-4 bg-white border border-slate-300 rounded-xl text-sm font-semibold text-slate-900 placeholder-slate-400 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 focus:outline-none shadow-2xs" />
                <span asp-validation-for="Title" class="text-xs text-rose-600 mt-1 block"></span>
            </div>

            <!-- Description -->
            <div>
                <label asp-for="Description" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-2">Description</label>
                <textarea asp-for="Description" rows="4" class="w-full p-3.5 bg-white border border-slate-300 rounded-xl text-xs font-medium text-slate-900 placeholder-slate-400 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 focus:outline-none shadow-2xs"></textarea>
                <span asp-validation-for="Description" class="text-xs text-rose-600 mt-1 block"></span>
            </div>

            <!-- Status & Priority Grid -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                    <label asp-for="StatusId" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-2">Status *</label>
                    <select asp-for="StatusId" required class="w-full py-2.5 px-3.5 bg-white border border-slate-300 rounded-xl text-xs font-semibold text-slate-800 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 focus:outline-none shadow-2xs">
                        @foreach (var s in Model.AvailableStatuses)
                        {
                            <option value="@s.Id" selected="@(Model.StatusId == s.Id)">@s.Name</option>
                        }
                    </select>
                    <span asp-validation-for="StatusId" class="text-xs text-rose-600 mt-1 block"></span>
                </div>

                <div>
                    <label asp-for="PriorityId" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-2">Priority *</label>
                    <select asp-for="PriorityId" required class="w-full py-2.5 px-3.5 bg-white border border-slate-300 rounded-xl text-xs font-semibold text-slate-800 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 focus:outline-none shadow-2xs">
                        @foreach (var p in Model.AvailablePriorities)
                        {
                            <option value="@p.Id" selected="@(Model.PriorityId == p.Id)">@p.Name</option>
                        }
                    </select>
                    <span asp-validation-for="PriorityId" class="text-xs text-rose-600 mt-1 block"></span>
                </div>
            </div>

            <!-- Assignee & Parent Task -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                    <label asp-for="AssignedUserId" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-2">Assignee</label>
                    <select asp-for="AssignedUserId" class="w-full py-2.5 px-3.5 bg-white border border-slate-300 rounded-xl text-xs font-semibold text-slate-800 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 focus:outline-none shadow-2xs">
                        <option value="">-- Unassigned --</option>
                        @foreach (var u in Model.AvailableUsers)
                        {
                            <option value="@u.Id" selected="@(Model.AssignedUserId == u.Id)">@u.FullName (@u.Email)</option>
                        }
                    </select>
                </div>

                <div>
                    <label asp-for="ParentTaskId" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-2">Parent Task</label>
                    <select asp-for="ParentTaskId" class="w-full py-2.5 px-3.5 bg-white border border-slate-300 rounded-xl text-xs font-semibold text-slate-800 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 focus:outline-none shadow-2xs">
                        <option value="">-- No Parent (Root Task) --</option>
                        @foreach (var pt in Model.AvailableParentTasks)
                        {
                            <option value="@pt.Id" selected="@(Model.ParentTaskId == pt.Id)">@pt.TaskNumber - @pt.Title</option>
                        }
                    </select>
                </div>
            </div>

            <!-- Estimate & Dates -->
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                <div>
                    <label asp-for="EstimatedHours" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-2">Estimate (Hours)</label>
                    <input asp-for="EstimatedHours" type="number" step="0.5" min="0" class="w-full py-2.5 px-3.5 bg-white border border-slate-300 rounded-xl text-xs font-semibold text-slate-800 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 focus:outline-none shadow-2xs" />
                </div>

                <div>
                    <label asp-for="StartedOn" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-2">Start Date</label>
                    <input asp-for="StartedOn" type="date" value="@(Model.StartedOn?.ToString("yyyy-MM-dd"))" class="w-full py-2.5 px-3.5 bg-white border border-slate-300 rounded-xl text-xs font-semibold text-slate-800 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 focus:outline-none shadow-2xs" />
                </div>

                <div>
                    <label asp-for="EndOn" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-2">Target End Date</label>
                    <input asp-for="EndOn" type="date" value="@(Model.EndOn?.ToString("yyyy-MM-dd"))" class="w-full py-2.5 px-3.5 bg-white border border-slate-300 rounded-xl text-xs font-semibold text-slate-800 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 focus:outline-none shadow-2xs" />
                </div>
            </div>

            <div class="flex items-center justify-end gap-3 pt-6 border-t border-slate-100">
                <a href="/Tasks/Details/@Model.Id" class="px-5 py-2.5 rounded-xl bg-white hover:bg-slate-50 text-slate-700 text-xs font-bold border border-slate-200 shadow-2xs transition">Cancel</a>
                <button type="submit" class="px-6 py-2.5 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-bold shadow-md shadow-indigo-500/20 transition">
                    Save Changes
                </button>
            </div>
        </form>
    </div>
</div>
