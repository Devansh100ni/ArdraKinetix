                <p class="text-3xl font-black text-slate-900 mt-2 tracking-tight">
                    Ready to elevate your sprint velocity?
                </p>
                <p class="text-xs text-slate-500 mt-2 leading-relaxed">
                    Access your isolated organization workspace with dedicated Scrum boards, subtask trees, and audit trail protection.
                </p>
                <div class="mt-8">
                    <a href="/Account/Login" class="inline-flex items-center gap-2 px-7 py-3.5 rounded-2xl bg-gradient-to-r from-sky-600 via-blue-600 to-cyan-600 hover:from-sky-700 hover:to-blue-700 text-white text-sm font-bold shadow-lg shadow-sky-500/25 transition transform hover:-translate-y-0.5 active:scale-98">
                        <span>Launch Workspace Gateway</span>
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
                    </a>
                </div>
            </div>
        </section>

    </main>

