@model AdminDashboardDto

<!-- Admin Dashboard Header -->
<div class="flex items-center justify-between">
    <div>
        <h2 class="text-2xl font-black text-slate-900 tracking-tight">Enterprise Overview</h2>
        <p class="text-xs text-slate-500 mt-0.5 font-medium">Global system telemetry across all active client tenants.</p>
    </div>

    <div class="flex items-center gap-3">
        <a href="/Admin/Tenants" class="px-3.5 py-2 rounded-xl bg-white hover:bg-slate-50 text-slate-700 text-xs font-bold border border-slate-200 shadow-2xs transition">
            Manage Tenants
        </a>
        <a href="/Admin/Users" class="px-3.5 py-2 rounded-xl bg-sky-600 hover:bg-sky-700 text-white text-xs font-bold shadow-md shadow-sky-500/20 transition">
            Manage Users
        </a>
    </div>
</div>

<!-- 4 Key Stat Cards -->
<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-5">
    <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm">
        <div class="flex items-center justify-between text-slate-500 mb-3">
            <span class="text-xs font-bold uppercase tracking-wider text-slate-500">Total Tenants</span>
            <div class="w-9 h-9 rounded-xl bg-sky-50 text-sky-600 flex items-center justify-center">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path></svg>
            </div>
        </div>
        <div class="text-3xl font-black text-slate-900">@Model.TotalTenants</div>
        <div class="text-[11px] text-emerald-600 mt-2 font-semibold flex items-center gap-1">
            <span>&bull;</span> All tenant sequence counters healthy
        </div>
    </div>

    <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm">
        <div class="flex items-center justify-between text-slate-500 mb-3">
            <span class="text-xs font-bold uppercase tracking-wider text-slate-500">Active Users</span>
            <div class="w-9 h-9 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"></path></svg>
            </div>
        </div>
        <div class="text-3xl font-black text-slate-900">@Model.ActiveUsers</div>
        <div class="text-[11px] text-slate-500 mt-2 font-medium">Across Admin, Dev & Tenant roles</div>
    </div>

    <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm">
        <div class="flex items-center justify-between text-slate-500 mb-3">
            <span class="text-xs font-bold uppercase tracking-wider text-slate-500">Total Tasks</span>
            <div class="w-9 h-9 rounded-xl bg-amber-50 text-amber-600 flex items-center justify-center">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path></svg>
            </div>
        </div>
        <div class="text-3xl font-black text-slate-900">@Model.TotalTasks</div>
        <div class="text-[11px] text-sky-600 mt-2 font-medium">Tracked across all Scrum boards</div>
    </div>

    <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm">
        <div class="flex items-center justify-between text-slate-500 mb-3">
            <span class="text-xs font-bold uppercase tracking-wider text-slate-500">Overdue Tasks</span>
            <div class="w-9 h-9 rounded-xl bg-rose-50 text-rose-600 flex items-center justify-center">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
            </div>
        </div>
        <div class="text-3xl font-black text-rose-600">@Model.OverdueTasksCount</div>
        <div class="text-[11px] text-rose-600/90 mt-2 font-medium">Passed end target date</div>
    </div>
</div>

<!-- Task Status & Priority Distributions -->
<div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
    <!-- Status Breakdown -->
    <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm">
        <h3 class="text-xs font-bold text-slate-800 uppercase tracking-wider mb-4">Tasks by Status</h3>
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-3">
            @foreach (var (status, count) in Model.TasksByStatus)
            {
                <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-200/80">
                    <div class="text-xs font-semibold text-slate-500 truncate">@status</div>
                    <div class="text-xl font-black text-slate-900 mt-1">@count</div>
                </div>
            }
        </div>
    </div>

    <!-- Priority Breakdown -->
    <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm">
        <h3 class="text-xs font-bold text-slate-800 uppercase tracking-wider mb-4">Tasks by Priority</h3>
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
            @foreach (var (priority, count) in Model.TasksByPriority)
            {
                <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-200/80">
                    <div class="text-xs font-semibold text-slate-500 truncate">@priority</div>
                    <div class="text-xl font-black text-slate-900 mt-1">@count</div>
                </div>
            }
        </div>
    </div>
</div>

<!-- Recent Tasks Table -->
<div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
    <div class="p-6 border-b border-slate-100 flex items-center justify-between">
        <div>
            <h3 class="text-base font-bold text-slate-900">Recently Created / Updated Tasks</h3>
            <p class="text-xs text-slate-500 mt-0.5">Live stream of tasks moving across tenant boards.</p>
        </div>
        <a href="/Tasks" class="text-xs font-bold text-sky-600 hover:text-sky-700">View All Tasks &rarr;</a>
    </div>

    @if (Model.RecentTasks.Count == 0)
    {
        <div class="p-8">
            <partial name="_EmptyState" model="@("No recent tasks found.")" />
        </div>
    }
    else
    {
        <div class="overflow-x-auto">
            <table class="w-full text-left text-xs text-slate-700">
                <thead class="bg-slate-50 text-slate-500 uppercase font-bold text-[10px] tracking-wider border-b border-slate-200">
                    <tr>
                        <th class="py-3.5 px-6">Task</th>
                        <th class="py-3.5 px-6">Tenant</th>
                        <th class="py-3.5 px-6">Status</th>
                        <th class="py-3.5 px-6">Priority</th>
                        <th class="py-3.5 px-6">Assignee</th>
                        <th class="py-3.5 px-6">Created On</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    @foreach (var task in Model.RecentTasks)
                    {
                        <tr class="hover:bg-slate-50/80 transition">
                            <td class="py-3.5 px-6 font-medium">
                                <a href="/Tasks/Details/@task.Id" class="font-mono font-bold text-sky-600 hover:underline mr-2">@task.TaskNumber</a>
                                <span class="text-slate-800 font-medium">@task.Title</span>
                            </td>
                            <td class="py-3.5 px-6">
                                <span class="px-2 py-0.5 rounded bg-slate-100 border border-slate-200 text-[11px] font-mono text-slate-700 font-bold">
                                    @task.TenantCode
                                </span>
                            </td>
                            <td class="py-3.5 px-6">
                                <span class="px-2.5 py-0.5 rounded-full text-[11px] font-bold border"
                                      style="background-color: @(task.StatusColor)15; color: @task.StatusColor; border-color: @(task.StatusColor)40;">
                                    @task.StatusName
                                </span>
                            </td>
                            <td class="py-3.5 px-6">
                                <span class="px-2.5 py-0.5 rounded-full text-[11px] font-bold border"
                                      style="background-color: @(task.PriorityColor)15; color: @task.PriorityColor; border-color: @(task.PriorityColor)40;">
                                    @task.PriorityName
                                </span>
                            </td>
                            <td class="py-3.5 px-6 font-medium text-slate-700">
                                @(task.AssignedUserName ?? "Unassigned")
                            </td>
                            <td class="py-3.5 px-6 text-slate-500 font-medium">
                                @task.CreatedOn.ToString("MMM dd, yyyy HH:mm")
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
