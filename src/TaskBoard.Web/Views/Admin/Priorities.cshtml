@model IReadOnlyList<TaskPriorityDto>
@{
    ViewData["Title"] = "Task Priority Management";
}

<div class="space-y-6 max-w-5xl mx-auto">
    <div class="flex items-center justify-between">
        <div>
            <h2 class="text-2xl font-black text-slate-900 tracking-tight">Task Priorities</h2>
            <p class="text-xs text-slate-500 mt-0.5 font-medium">Configure priority levels, ordering, and badge colors.</p>
        </div>
    </div>

    <!-- Create Priority Card -->
    <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm">
        <h3 class="text-xs font-bold uppercase tracking-wider text-slate-700 mb-3">Add New Priority</h3>
        <form asp-action="PrioritiesCreate" method="post" class="grid grid-cols-1 sm:grid-cols-5 gap-3 items-end">
            @Html.AntiForgeryToken()
            <div class="sm:col-span-2">
                <label class="block text-[11px] font-bold text-slate-700 mb-1">Priority Name *</label>
                <input type="text" name="Name" required placeholder="e.g. Blocker" class="w-full py-2 px-3 bg-white border border-slate-300 rounded-xl text-xs font-semibold text-slate-900 focus:outline-none focus:ring-2 focus:ring-sky-500 focus:border-sky-500 shadow-2xs" />
            </div>
            <div>
                <label class="block text-[11px] font-bold text-slate-700 mb-1">Code *</label>
                <input type="text" name="Code" required placeholder="BLOCKER" class="w-full py-2 px-3 bg-white border border-slate-300 rounded-xl text-xs font-mono font-bold text-slate-900 uppercase focus:outline-none focus:ring-2 focus:ring-sky-500 focus:border-sky-500 shadow-2xs" />
            </div>
            <div>
                <label class="block text-[11px] font-bold text-slate-700 mb-1">Hex Color</label>
                <input type="color" name="Color" value="#ef4444" class="w-full h-9 p-1 bg-white border border-slate-300 rounded-xl cursor-pointer" />
            </div>
            <div>
                <button type="submit" class="w-full py-2 px-4 bg-sky-600 hover:bg-sky-700 text-white text-xs font-bold rounded-xl shadow-md shadow-sky-500/20 transition">
                    + Add Priority
                </button>
            </div>
        </form>
    </div>

    <!-- Priorities List -->
    <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-left text-xs text-slate-700">
                <thead class="bg-slate-50 text-slate-500 uppercase font-bold text-[10px] tracking-wider border-b border-slate-200">
                    <tr>
                        <th class="py-3.5 px-6">Order</th>
                        <th class="py-3.5 px-6">Priority</th>
                        <th class="py-3.5 px-6">Code</th>
                        <th class="py-3.5 px-6">Preview Badge</th>
                        <th class="py-3.5 px-6">Status</th>
                        <th class="py-3.5 px-6 text-right">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    @foreach (var p in Model.OrderBy(p => p.DisplayOrder))
                    {
                        <tr class="hover:bg-slate-50/80 transition">
                            <td class="py-3.5 px-6 font-mono text-slate-500 font-bold">@p.DisplayOrder</td>
                            <td class="py-3.5 px-6 font-bold text-slate-900">@p.Name</td>
                            <td class="py-3.5 px-6 font-mono text-slate-600">@p.Code</td>
                            <td class="py-3.5 px-6">
                                <span class="px-2.5 py-0.5 rounded-full text-[11px] font-bold border"
                                      style="background-color: @(p.Color)15; color: @p.Color; border-color: @(p.Color)40;">
                                    @p.Name
                                </span>
                            </td>
                            <td class="py-3.5 px-6">
                                @if (p.IsActive)
                                {
                                    <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-emerald-50 text-emerald-700 border border-emerald-200">Active</span>
                                }
                                else
                                {
                                    <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-rose-50 text-rose-700 border border-rose-200">Inactive</span>
                                }
                            </td>
                            <td class="py-3.5 px-6 text-right">
                                <form asp-action="PrioritiesToggleStatus" asp-route-id="@p.Id" method="post" class="inline">
                                    <button type="submit" class="px-3 py-1 bg-slate-100 hover:bg-slate-200 text-slate-600 hover:text-slate-900 rounded-lg font-bold transition">
                                        @(p.IsActive ? "Deactivate" : "Activate")
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
