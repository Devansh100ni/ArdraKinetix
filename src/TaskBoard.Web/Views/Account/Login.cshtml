                                <div class="flex items-center justify-between mb-0.5">
                                    <span class="px-1.5 py-0.5 rounded text-[9px] font-extrabold bg-sky-100 text-sky-700">Tenant</span>
                                </div>
                                <div class="font-bold text-slate-800 text-[11px] group-hover:text-sky-700 truncate">acmeuser</div>
                                <div class="text-[9px] text-slate-400 font-mono">Acme Corp</div>
                            </button>
                        </div>
                    </div>

                    <!-- Card Footer Attribution & Back to Home -->
                    <div class="mt-5 pt-3.5 border-t border-slate-100 flex items-center justify-between text-xs">
                        <a href="/" class="inline-flex items-center gap-1 text-[11px] font-semibold text-slate-500 hover:text-sky-600 transition group">
                            <svg class="w-3.5 h-3.5 text-sky-600 group-hover:-translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
                            <span>Back to Home</span>
                        </a>
                        <p class="text-xs font-semibold text-slate-600">
                            Co-powered by <span class="text-sky-600 font-bold">CodeArdra Solutions</span>
                        </p>
                    </div>
                    <div class="pt-1 text-center">
                        <p class="text-[10px] text-slate-400">
                            Protected by PBKDF2 HMAC-SHA512 &bull; <a href="#" class="text-sky-600 hover:underline font-semibold">Security Policy</a>
                        </p>
                    </div>

                </div>
            </div>

        </div>
    </main>

    <!-- ========================================== -->
