@model AdminTenantsViewModel
@{
    ViewData["Title"] = "Tenant Management";
}

<div class="space-y-6 max-w-7xl mx-auto">
    <div class="flex items-center justify-between">
        <div>
            <h2 class="text-2xl font-black text-slate-900 tracking-tight">Organization Tenants</h2>
            <p class="text-xs text-slate-500 mt-0.5 font-medium">Manage multi-tenant client partitions and task prefix sequences.</p>
        </div>

        <a href="/Admin/TenantsCreate" class="px-4 py-2 rounded-xl bg-sky-600 hover:bg-sky-700 text-white text-xs font-bold shadow-md shadow-sky-500/20 transition">
            + Add New Tenant
        </a>
    </div>

    <!-- Filter Bar -->
    <div class="bg-white p-4 rounded-2xl border border-slate-200 shadow-sm">
        <form method="get" class="flex items-center gap-3">
            <input type="text" name="Search" value="@Model.Filter.Search" placeholder="Search by name, code, or prefix..." class="w-72 py-2 px-3 bg-white border border-slate-300 rounded-xl text-xs font-medium text-slate-900 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-sky-500 focus:border-sky-500 shadow-2xs" />
            <button type="submit" class="px-4 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-bold rounded-xl transition">Search</button>
            <a href="/Admin/Tenants" class="text-xs font-medium text-slate-500 hover:text-slate-900">Reset</a>
        </form>
    </div>

    <!-- Tenants Table -->
    <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
        @if (Model.Tenants.Items.Count == 0)
        {
            <div class="p-8">
                <partial name="_EmptyState" model="@("No tenants registered in the system.")" />
            </div>
        }
        else
        {
            <div class="overflow-x-auto">
                <table class="w-full text-left text-xs text-slate-700">
                    <thead class="bg-slate-50 text-slate-500 uppercase font-bold text-[10px] tracking-wider border-b border-slate-200">
                        <tr>
                            <th class="py-3.5 px-6">Name</th>
                            <th class="py-3.5 px-6">Code</th>
                            <th class="py-3.5 px-6">Task Prefix</th>
                            <th class="py-3.5 px-6">Next Number</th>
                            <th class="py-3.5 px-6">Status</th>
                            <th class="py-3.5 px-6">Created On</th>
                            <th class="py-3.5 px-6 text-right">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100">
                        @foreach (var tenant in Model.Tenants.Items)
                        {
                            <tr class="hover:bg-slate-50/80 transition">
                                <td class="py-3.5 px-6 font-bold text-slate-900">@tenant.Name</td>
                                <td class="py-3.5 px-6 font-mono text-sky-600 font-bold">@tenant.Code</td>
                                <td class="py-3.5 px-6 font-mono font-bold text-slate-800">@tenant.Prefix</td>
                                <td class="py-3.5 px-6 font-mono text-emerald-600 font-bold">@tenant.Prefix-@((tenant.LastSequenceNumber + 1).ToString("D6"))</td>
                                <td class="py-3.5 px-6">
                                    @if (tenant.IsActive)
                                    {
                                        <span class="px-2.5 py-0.5 rounded-full text-[11px] font-bold bg-emerald-50 text-emerald-700 border border-emerald-200">Active</span>
                                    }
                                    else
                                    {
                                        <span class="px-2.5 py-0.5 rounded-full text-[11px] font-bold bg-rose-50 text-rose-700 border border-rose-200">Inactive</span>
                                    }
                                </td>
                                <td class="py-3.5 px-6 text-slate-500 font-medium">@tenant.CreatedOn.ToString("MMM dd, yyyy")</td>
                                <td class="py-3.5 px-6 text-right">
                                    <div class="flex items-center justify-end gap-2">
                                        <a href="/Admin/TenantsEdit/@tenant.Id" class="px-3 py-1 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-lg font-bold transition">
                                            Edit
                                        </a>
                                        <form asp-action="TenantsToggleStatus" asp-route-id="@tenant.Id" method="post">
                                            <button type="submit" class="px-3 py-1 bg-slate-100 hover:bg-slate-200 text-slate-600 hover:text-slate-900 rounded-lg font-bold transition">
                                                @(tenant.IsActive ? "Deactivate" : "Activate")
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <partial name="_Pagination" model="Model.Tenants" />
        }
    </div>
</div>
