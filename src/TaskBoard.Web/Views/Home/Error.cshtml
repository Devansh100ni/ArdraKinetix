@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="max-w-xl mx-auto mt-16 text-center">
    <div class="w-20 h-20 rounded-3xl bg-rose-500/10 border border-rose-500/20 flex items-center justify-center text-rose-400 mx-auto mb-6 shadow-2xl">
        <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
    </div>

    <h1 class="text-3xl font-black text-white mb-2">Error (@Model.StatusCode)</h1>
    <p class="text-slate-400 text-sm mb-6 leading-relaxed">
        @Model.ErrorMessage
    </p>

    @if (Model.ShowRequestId)
    {
        <div class="p-3 bg-slate-900 border border-slate-800 rounded-xl font-mono text-xs text-slate-400 mb-6 inline-block">
            Correlation ID: @Model.RequestId
        </div>
    }

    <div class="flex items-center justify-center gap-4">
        <a href="/Dashboard" class="px-5 py-2.5 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white text-xs font-bold shadow-lg transition">
            Back to Dashboard
        </a>
    </div>
</div>
